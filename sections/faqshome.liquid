{% comment %} faq-section-v2.liquid {% endcomment %}
{% if request.page_type == 'index' %}
<section class="faq2-section">
  <div class="faq2-inner">
    <h2 class="faq2-title">{{ section.settings.title }}</h2>

    <div class="faq2-list">
      {% for i in (1..7) %}
        {% assign q_key = 'q' | append: i %}
        {% assign a_key = 'a' | append: i %}
        {% assign question = section.settings[q_key] %}
        {% assign answer = section.settings[a_key] %}
        {% if question != blank %}
          <div class="faq2-item">
            <button class="faq2-question" aria-expanded="false">
              <span>{{ question }}</span>
              <svg class="faq2-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
            <div class="faq2-answer">
              <div class="faq2-answer-inner">{{ answer }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&display=swap');

.faq2-section {
  width: 100%;
  background: #f4f4f4;
  padding: 30px 24px;
}

.faq2-inner {
  max-width: 1000px;
  margin: 0 auto;
}

.faq2-title {
  text-align: center;
  font-family: 'Lora', serif;
  font-size: clamp(22px, 3vw, 36px);
  font-weight: 700;
  color: #111;
  margin: 0 0 40px;
  letter-spacing: -0.5px;
}

.faq2-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.faq2-item {
  border-radius: 8px;
  overflow: hidden;
}

.faq2-question {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: #D83C36;
  color: #fff;
  border: none;
  padding: 18px 22px;
  font-size: 15px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  border-radius: 8px;
  transition: background 0.2s;
}

.faq2-question:hover {
  background: #245a41;
}

.faq2-question[aria-expanded="true"] {
  border-radius: 8px 8px 0 0;
  background: #2d6a4f;
}

.faq2-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.faq2-question[aria-expanded="true"] .faq2-icon {
  transform: rotate(90deg);
}

.faq2-answer {
  max-height: 0;
  overflow: hidden;
  background: #fff;
  border-radius: 0 0 8px 8px;
  transition: max-height 0.35s ease;
}

.faq2-answer-inner {
  padding: 24px 22px;
  font-size: 15px;
  line-height: 1.75;
  color: #333;
}

.faq2-answer-inner p {
  margin: 0;
}

@media (max-width: 700px) {
  .faq2-section {
    padding: 20px 16px;
  }
  .faq2-question {
    font-size: 14px;
    padding: 16px 18px;
  }
  .faq2-answer-inner {
    font-size: 14px;
    padding: 20px 18px;
  }
}
</style>

<script>
document.querySelectorAll('.faq2-question').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var expanded = this.getAttribute('aria-expanded') === 'true';
    var answer = this.nextElementSibling;

    document.querySelectorAll('.faq2-question').forEach(function(other) {
      other.setAttribute('aria-expanded', 'false');
      other.nextElementSibling.style.maxHeight = null;
    });

    if (!expanded) {
      this.setAttribute('aria-expanded', 'true');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  });
});
</script>

{% schema %}
{
  "name": "FAQ Section V2",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "q1",
      "label": "Question 1",
      "default": "What are Soursop Gummies?"
