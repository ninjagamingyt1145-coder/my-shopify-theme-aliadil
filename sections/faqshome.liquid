    {
      "type": "text",
      "id": "q7",
      "label": "Question 7",
      "default": "How long before I see results?"
    },
    {
      "type": "richtext",
      "id": "a7",
      "label": "Answer 7",
      "default": "<p>Most customers begin to notice a difference within 2–4 weeks of consistent use. For optimal results, we recommend taking them daily for at least 60 days.</p>"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section V2"
    }
  ]
}
{% endschema %}