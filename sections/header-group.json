            "paragraph_6": "",
            "paragraph_7": "",
            "background_color": "#ffffff",
            "vertical_padding": 20,
            "image_max_width": 300,
            "image_border_color": "#ffffff",
            "heading": "<p>5. One Formula Replaces Five Random Bottles</p>",
            "heading_size": 32,
