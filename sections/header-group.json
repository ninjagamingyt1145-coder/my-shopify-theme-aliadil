          "settings": {
            "paragraph_7": "",
            "paragraph_6": "",
            "paragraph_5": "",
            "paragraph_4": "",
            "background_color": "#000000",
            "heading": "<p>4. Makes TRT Work Without The Tradeoff</p>",
            "paragraph_1": "<p>TRT gives you the energy, the strength, and the drive. But it thickens your blood every week you pin. Hemo Flow removes the tradeoff. You get everything TRT gives you without your blood being the price you pay.</p>",
            "paragraph_2": "",
            "paragraph_3": "",
            "text_color": "#ffffff",
            "heading_size": 32,
            "paragraph_size": 16,
            "button_text": "",
            "button_link": "",
