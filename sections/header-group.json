          "name": "Blog split layout33",
          "settings": {
            "paragraph_7": "",
            "paragraph_6": "",
            "paragraph_5": "",
            "paragraph_4": "",
            "background_color": "#000000",
            "heading": "<p>2. Blood Pressure Stays Down Without a Prescription</p>",
            "paragraph_1": "<p>TRT makes your blood thicker and your vessels tighter. That's why your BP creeps up on cycle. Hemo Flow contains a patented ACE inhibitor that relaxes blood vessels through the same mechanism as prescription meds. No side effects. No prescription.</p>",
            "paragraph_2": "",
            "paragraph_3": "",
