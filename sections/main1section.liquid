{% comment %} testimonials-slider.liquid {% endcomment %}

<section class="ts-section" style="background: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="ts-container">
    <h2 class="ts-heading" style="color: {{ section.settings.heading_color }}; font-family: {{ section.settings.heading_font.family }}, sans-serif; font-weight: {{ section.settings.heading_font.weight }};">{{ section.settings.heading }}</h2>
    <div class="ts-wrapper">
      <div class="ts-track-outer">
        <div class="ts-track">
          {% for block in section.blocks %}
            <div class="ts-card" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="ts-img-wrap">
                  <img src="{{ block.settings.image | img_url: '400x600', crop: 'top' }}" alt="{{ block.settings.name }}" class="ts-img" loading="lazy">
                </div>
              {% endif %}
              <div class="ts-card-body">
                <div class="ts-stars" style="color: {{ section.settings.star_color }};">★★★★★</div>
                <p class="ts-review" style="color: {{ section.settings.text_color }};">{{ block.settings.review }}</p>
                <p class="ts-name" style="color: {{ section.settings.name_color }};">{{ block.settings.name }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="ts-bottom">
      <button class="ts-arrow ts-prev" aria-label="Previous">
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="27" y1="7" x2="1" y2="7" stroke="currentColor" stroke-width="1.5"/>
          <polyline points="7,1 1,7 7,13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="ts-dots"></div>
      <button class="ts-arrow ts-next" aria-label="Next">
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="1" y1="7" x2="27" y2="7" stroke="currentColor" stroke-width="1.5"/>
          <polyline points="21,1 27,7 21,13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
.ts-section {
  padding-top: 20px;
  padding-bottom: 40px;
}
.ts-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}
.ts-heading {
  text-align: center;
  font-size: clamp(18px, 2.5vw, 28px);
  font-weight: 800;
  margin: 0 0 36px;
  line-height: 1.3;
}
.ts-wrapper {
  overflow: hidden;
}
.ts-track {
  display: flex;
  gap: 16px;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
  align-items: flex-start;
}
.ts-card {
  flex: 0 0 calc(20% - 13px);
  background: #fff;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0,0,0,0.07);
  display: flex;
  flex-direction: column;
}
.ts-img-wrap {
  width: 100%;
  height: 320px;
  overflow: hidden;
  border-radius: 0;
  flex-shrink: 0;
}
.ts-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.ts-card-body {
  padding: 14px 16px 18px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: center;
  text-align: center;
}
.ts-stars {
  font-size: 18px;
  line-height: 1;
  letter-spacing: 1px;
}
.ts-review {
  font-size: 13px;
  line-height: 1.65;
  margin: 0;
  flex: 1;
  text-align: center;
}
.ts-name {
  font-size: 13px;
  font-weight: 700;
  margin: 0;
  text-align: center;
}
.ts-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 32px;
}
.ts-dots {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ts-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: transparent;
  border: 1.5px solid #888;
  cursor: pointer;
  padding: 0;
  transition: background 0.3s, border-color 0.3s;
}
.ts-dot.active {
  background: {{ section.settings.star_color }};
  border-color: {{ section.settings.star_color }};
  width: 10px;
  height: 10px;
}
.ts-arrow {
  background: transparent;
  border: none;
  cursor: pointer;
  color: #555;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  transition: color 0.2s;
}
.ts-arrow:hover {
  color: #000;
}
@media (max-width: 900px) {
  .ts-card { flex: 0 0 calc(33.333% - 11px); }
  .ts-img-wrap { height: 260px; }
}
@media (max-width: 600px) {
  .ts-card { flex: 0 0 calc(50% - 8px); }
  .ts-img-wrap { height: 200px; }
  .ts-heading { margin-bottom: 20px; }
  .ts-review { font-size: 11px; line-height: 1.5; }
  .ts-name { font-size: 11px; }
  .ts-stars { font-size: 14px; }
  .ts-card-body { padding: 10px 10px 14px; gap: 4px; }
}
</style>

<script>
(function() {
  var section = document.querySelector('.ts-section');
  if (!section) return;

  var track = section.querySelector('.ts-track');
  var cards = Array.from(section.querySelectorAll('.ts-card'));
  var dotsContainer = section.querySelector('.ts-dots');
  var prevBtn = section.querySelector('.ts-prev');
  var nextBtn = section.querySelector('.ts-next');

  var total = cards.length;
  var current = 0;
  var autoTimer = null;

  function getVisible() {
    var w = window.innerWidth;
    if (w <= 600) return 2;
    if (w <= 900) return 3;
    return 5;
  }

  function getMaxIndex() {
    return Math.max(0, total - getVisible());
  }

  function buildDots() {
    dotsContainer.innerHTML = '';
    var max = getMaxIndex();
    for (var i = 0; i <= max; i++) {
      var dot = document.createElement('button');
      dot.className = 'ts-dot' + (i === current ? ' active' : '');
      dot.setAttribute('aria-label', 'Slide ' + (i + 1));
      dot.dataset.index = i;
      dotsContainer.appendChild(dot);
    }
    dotsContainer.querySelectorAll('.ts-dot').forEach(function(dot) {
      dot.addEventListener('click', function() {
        stopAuto();
        goTo(parseInt(this.dataset.index));
        startAuto();
      });
    });
  }

  function getCardWidth() {
    var gap = 16;
    return cards[0].offsetWidth + gap;
  }

  function goTo(index) {
    var max = getMaxIndex();
    current = Math.max(0, Math.min(index, max));
    track.style.transform = 'translateX(-' + (current * getCardWidth()) + 'px)';
    var dots = dotsContainer.querySelectorAll('.ts-dot');
    dots.forEach(function(d, i) {
      d.classList.toggle('active', i === current);
    });
  }

  function startAuto() {
    autoTimer = setInterval(function() {
      var next = current >= getMaxIndex() ? 0 : current + 1;
      goTo(next);
    }, 3000);
  }

  function stopAuto() {
    clearInterval(autoTimer);
  }

  prevBtn.addEventListener('click', function() {
    stopAuto();
    goTo(current - 1);
    startAuto();
  });

  nextBtn.addEventListener('click', function() {
    stopAuto();
    goTo(current + 1);
    startAuto();
  });

  window.addEventListener('resize', function() {
    buildDots();
    goTo(current);
  });

  buildDots();
  startAuto();
})();
</script>

