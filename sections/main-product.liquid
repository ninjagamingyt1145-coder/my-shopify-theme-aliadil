  <style>
    .elare-accordion-block-container {
      width: 100% !important;
      max-width: 100% !important;
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
      box-sizing: border-box !important;
    }

    /* Native Details Wrapper */
    .elare-accordion-item {
      border-bottom: 1.5px dashed var(--border-color) !important;
      width: 100% !important;
      display: block !important;
    }
    
    .elare-accordion-block-container .elare-accordion-item:first-of-type {
      border-top: 1.5px dashed var(--border-color) !important;
    }

    /* Summary / Trigger Styling */
    .elare-accordion-trigger {
      width: 100% !important;
      background: transparent !important;
      padding: 18px 5px !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      cursor: pointer !important;
      text-align: left !important;
      color: var(--text-color) !important;
      outline: none !important;
      gap: 15px !important;
      list-style: none !important; /* Hide native browser marker */
    }

    /* Hide default summary arrow in Safari/Chrome */
    .elare-accordion-trigger::-webkit-details-marker {
      display: none !important;
    }

    .accordion-headline-text {
      font-size: 16px !important;
      font-weight: 600 !important;
      letter-spacing: -0.2px !important;
      line-height: 1.3 !important;
      margin: 0 !important;
      font-family: var(--font-heading-family), sans-serif !important;
    }

    /* Plus / Minus Custom CSS Engine */
    .accordion-toggle-status-icon {
      position: relative !important;
      width: 14px !important;
      height: 14px !important;
      flex-shrink: 0 !important;
      display: block !important;
    }

    .accordion-toggle-status-icon::before,
    .accordion-toggle-status-icon::after {
      content: '' !important;
      position: absolute !important;
      background-color: var(--text-color) !important;
      transition: transform 0.2s ease !important;
      top: 50% !important;
      left: 50% !important;
    }

    /* Horizontal line */
    .accordion-toggle-status-icon::before {
      width: 14px !important;
      height: 1.5px !important;
      transform: translate(-50%, -50%) !important;
    }

    /* Vertical line */
    .accordion-toggle-status-icon::after {
      width: 1.5px !important;
      height: 14px !important;
      transform: translate(-50%, -50%) !important;
    }

    /* When open, rotate/hide the vertical line to form a perfect minus symbol */
    .elare-accordion-item[open] .accordion-toggle-status-icon::after {
      transform: translate(-50%, -50%) rotate(90deg) scale(0) !important;
    }

    /* Content Area styling */
    .elare-accordion-content-panel {
      width: 100% !important;
    }

    .accordion-inner-body-richtext {
      padding: 0 5px 20px 5px !important;
      font-size: 14.5px !important;
      line-height: 1.5 !important;
      color: var(--text-color) !important;
      opacity: 0.85 !important;
      font-family: var(--font-body-family), sans-serif !important;
    }

    .accordion-inner-body-richtext p {
      margin: 0 0 10px 0 !important;
    }
    .accordion-inner-body-richtext p:last-child {
      margin: 0 !important;
    }

    /* 📱 Compact Mobile Views */
    @media screen and (max-width: 749px) {
      .elare-accordion-trigger {
        padding: 11px 2px !important;
      }

      .accordion-headline-text {
        font-size: 13.5px !important;
        letter-spacing: -0.1px !important;
      }

      .accordion-toggle-status-icon {
        width: 11px !important;
        height: 11px !important;
      }

      .accordion-toggle-status-icon::before {
        width: 11px !important;
        height: 1.2px !important;
      }

      .accordion-toggle-status-icon::after {
        width: 1.2px !important;
        height: 11px !important;
      }
      
      .accordion-inner-body-richtext {
        font-size: 12.5px !important;
        padding: 0 2px 14px 2px !important;
      }
    }
  </style>
  {%- when 'video_testimonials' -%}
  <div class="video-testimonial-section" {{ block.shopify_attributes }} style="margin: 0 0 30px 0; width: 100%; text-align: center; overflow: hidden;">
    
    <h3 style="font-family: var(--font-body-family); font-weight: 700; font-size: 22px; margin-bottom: 20px;">
      {{ block.settings.heading }}
    </h3>

    {% comment %} Video Wrapper {% endcomment %}
    <div id="videoSlider-{{ block.id }}" class="video-grid" style="display: flex; transition: transform 0.4s ease-in-out;">
      {%- for i in (1..3) -%}
        {%- assign video_id = 'product_video_' | append: i -%}
        {%- assign video_file = block.settings[video_id] -%}
        <div class="video-item-wrapper" style="flex: 0 0 33.333%; padding: 0 7px; box-sizing: border-box;">
          <div style="position: relative; border-radius: 15px; overflow: hidden; aspect-ratio: 9/16; background: #000;">
            {%- if video_file != blank -%}
              {{ video_file | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ugc-video', style: 'width: 100%; height: 100%; object-fit: cover; pointer-events: none;' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {% comment %} Mobile Navigation Dots (Only for Mobile) {% endcomment %}
    <div class="mobile-nav-dots" style="display: none; justify-content: center; gap: 12px; margin-top: 20px;">
       <button onclick="slideVideos(0, this)" class="dot active" style="width: 12px; height: 12px; background: #333; border: none; border-radius: 50%; padding: 0; cursor: pointer; opacity: 1;"></button>
       <button onclick="slideVideos(1, this)" class="dot" style="width: 12px; height: 12px; background: #ccc; border: none; border-radius: 50%; padding: 0; cursor: pointer; opacity: 0.5;"></button>
    </div>

    <style>
      /* Mobile Layout Rules */
      @media screen and (max-width: 749px) {
        .video-item-wrapper {
          flex: 0 0 50% !important; /* Show 2 videos on mobile */
        }
        .mobile-nav-dots {
          display: flex !important;
        }
      }
      .dot.active { opacity: 1 !important; background: #333 !important; }
    </style>

    <script>
      function slideVideos(index, btn) {
        const slider = document.getElementById('videoSlider-{{ block.id }}');
        const dots = btn.parentElement.querySelectorAll('.dot');
        
        // Slide calculation (50% per dot for 2-video view)
        const moveValue = index * 50;
        slider.style.transform = `translateX(-${moveValue}%)`;
        
        // Update dots appearance
        dots.forEach(d => {
          d.style.opacity = "0.5";
          d.style.background = "#ccc";
        });
        btn.style.opacity = "1";
        btn.style.background = "#333";
      }
    </script>
