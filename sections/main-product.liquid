  <script>
    document.addEventListener("DOMContentLoaded", function() {
      function getFormattedFutureDate(daysToAdd) {
        const targetDate = new Date();
        targetDate.setDate(targetDate.getDate() + daysToAdd);
        
        const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        
        const monthName = months[targetDate.getMonth()];
        const day = targetDate.getDate();
        
        return `${monthName} ${day}`;
      }

      // Automatically calculates tomorrow's shipping cutoff target
      const dateElements = document.querySelectorAll(".tsl-dynamic-date");
      const formattedDate = getFormattedFutureDate(1); 
      
      dateElements.forEach(el => {
        el.textContent = formattedDate;
      });
    });
  </script>

