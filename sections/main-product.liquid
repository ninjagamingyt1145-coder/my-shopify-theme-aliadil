        <div class="exc-countdown-text-group">
          <h4 class="exc-countdown-heading">{{ block.settings.heading | default: "HOT SALE" }}</h4>
          <p class="exc-countdown-subtext">{{ block.settings.subtext | default: "Ordena antes del 24 de junio de 2026 para recibir regalos GRATIS" }}</p>
        </div>
      </div>

      <div class="exc-countdown-timer-clock" data-hours="{{ block.settings.hours | default: 6 }}" data-minutes="{{ block.settings.minutes | default: 22 }}" data-seconds="{{ block.settings.seconds | default: 7 }}">
        <div class="exc-time-box">
