<section
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.desktop_padding_top }}px;
        padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      }
    }

    #MediaGallery-{{ section.id }} {
      --desktop-thumbnails: {{ section.settings.desktop_thumbnails_count }};
      --desktop-vertical-thumbnails-width: {{ section.settings.desktop_vertical_thumbnails_width }}%;
      --mobile-thumbnails: {{ section.settings.mobile_thumbnails_count }};
      --mobile-vertical-thumbnails-width: {{ section.settings.mobile_vertical_thumbnails_width }}%;
    }
    @media screen and (max-width: 749px) {
      #MediaGallery-{{ section.id }} {
        --media-radius: {{ section.settings.mobile_media_corner_radius }}px;
        --grid-mobile-horizontal-spacing: {{ section.settings.mobile_spacing_pixels }}px;
        --mobile-scroll-padding: calc({{ section.settings.mobile_scroll_padding_percentage }}% + {{ section.settings.mobile_scroll_padding_pixels }}px);
        --slide-container-percentage-width: {{ section.settings.mobile_slides_container_width }}%;
        --slide-inner-percentage-width: {{ section.settings.mobile_slides_inner_width }}%;
      }
    }
  {%- endstyle -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  {% if section.settings.display_id %}
    <copy-button class='section-id-btn button' data-content="#shopify-section-{{ section.id }}" data-success="false">
      <span class="copy-text">Click to copy section ID</span>
      <span class="copy-success">ID copied successfully!</span>
    </copy-button>
  {% endif %}

  {%- liquid
    assign has_filtering = false
    if section.settings.variant_image_filtering != 'none'
      assign has_filtering = true
    endif
  
    assign hide_variants_enabled = false
    if section.settings.hide_variants and has_filtering != true
      assign hide_variants_enabled = true
    endif
  
    if hide_variants_enabled and variant_images.size == product.media.size
      assign single_media_visible = true
    endif
  
    assign media_count = product.media.size
    if hide_variants_enabled and media_count > 1 and variant_images.size > 0
      assign media_count = media_count | minus: variant_images.size | plus: 1
    endif
  
    if media_count == 1 or single_media_visible
      assign single_media_visible_mobile = true
    endif
  
    if media_count == 0 or single_media_visible_mobile or section.settings.mobile_thumbnails_position != 'hidden' and media_count < 3
      assign hide_mobile_slider = true
    endif
  -%}
  <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
    <div class="grid__item product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}">
      {% render 'product-media-gallery', variant_images: variant_images, has_filtering: has_filtering, section %}
    </div>
    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}{% if section.settings.mobile_pagination == 'dots_overlay' or hide_mobile_slider %} product__info-wrapper--top-padding{% endif %}">
      <product-info
        id="ProductInfo-{{ section.id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        class="product__info-container main-product__info-container"
      >
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              {% render 'text-with-icon-block', block: block, margins: true, block_attributes: true %}
            {%- when 'title' -%}
              <div class="product__title" {{ block.shopify_attributes }} style="--margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;--margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;">
                <h1 class="{{ block.settings.text_size }}{% if block.settings.uppercase_title %} product-title--uppercase{% endif %}{% if block.settings.title_alignment == 'center' %} center{% endif %}">
                  {{ product.title }}
                </h1>
                <a href="{{ product.url }}" class="product__title">
                  <h2 class="h1">
                    {{ product.title }}
                  </h2>
                </a>
              </div>
            {% when 'rating_stars' %}
              {% render 'rating-stars-block', block: block, margins: true, block_attributes: true %}
            {% when 'trustpilot_stars' %}
              {% render 'trustpilot-stars-block', block: block, margins: true, block_attributes: true %}
         {%- when 'std_main_heading' -%}
  <div class="tsl-main-heading-block-wrapper" {{ block.shopify_attributes }} style="
    --padding-top: {{ block.settings.padding_top | default: 16 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 16 }}px;
    --text-color: {{ block.settings.text_color | default: '#0f2c59' }};
    --font-size-desktop: {{ block.settings.font_size_desktop | default: 32 }}px;
    --font-size-mobile: {{ block.settings.font_size_mobile | default: 24 }}px;
    --font-weight: {{ block.settings.font_weight | default: '700' }};
    --text-alignment: {{ block.settings.text_alignment | default: 'left' }};
  ">
    {%- if block.settings.heading_text != blank -%}
      <h2 class="tsl-custom-theme-heading-node">
        {{ block.settings.heading_text }}
      </h2>
    {%- endif -%}
  </div>

  <style>
    .tsl-main-heading-block-wrapper {
      width: 100% !important;
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
      box-sizing: border-box !important;
      clear: both !important;
      overflow: hidden !important; /* Prevents any layout cracking */
    }

    .tsl-custom-theme-heading-node {
      font-family: var(--font-heading-family), var(--font-body-family), sans-serif !important;
      font-size: var(--font-size-desktop) !important;
      font-weight: var(--font-weight) !important;
      color: var(--text-color) !important;
      text-align: var(--text-alignment) !important;
      line-height: 1.25 !important;
      margin: 0 !important;
      padding: 0 !important;
      letter-spacing: -0.5px !important;
      word-break: break-word !important;
    }

    /* 📱 Fluid Mobile Screen Viewport Adjustments */
    @media screen and (max-width: 749px) {
      .tsl-custom-theme-heading-node {
        /* Forces the text to stay on a single line */
        white-space: nowrap !important;
        
        /* Uses a fluid clamp to dynamically downscale font size on small screens so it never overflows */
        font-size: clamp(14px, 5.5vw, var(--font-size-mobile)) !important;
        letter-spacing: -0.3px !important;
        line-height: 1.25 !important;
      }
    }
  </style>
                    {%- when 'feature_list' -%}
  <div class="product-feature-list" style="margin: 20px 0; background: transparent;">
    <ul style="list-style: none; padding: 0; margin: 0;">
      
      {%- for i in (1..5) -%}
        {%- assign setting_id = 'line_' | append: i -%}
        {%- assign current_text = block.settings[setting_id] -%}
        
        {%- if current_text != blank -%}
          <li style="display: flex; align-items: flex-start; margin-bottom: 10px; gap: 10px;">
            {% comment %} Orange Checkmark Icon {% endcomment %}
            <div style="flex-shrink: 0; width: 20px; height: 20px; background: #315A22; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 2px;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            
            {% comment %} White Feature Text - Fixed for No Cutting {% endcomment %}
            <span class="feature-text-span" style="font-size: 14px; font-weight: 700; color: #000000; line-height: 1.25; letter-spacing: -0.2px; display: block; word-break: break-word;">
              {{ current_text }}
            </span>
          </li>
        {%- endif -%}
      {%- endfor -%}

    </ul>
  </div>

  <style>
    @media screen and (max-width: 749px) {
      /* Mobile par font size aur gap thora aur optimize kiya taake 2 lines mein sab aa jaye */
      .product-feature-list li {
        gap: 8px !important;
        margin-bottom: 8px !important;
      }
      .product-feature-list li span { 
        font-size: 12.5px !important; 
        line-height: 1.2 !important;
        letter-spacing: -0.3px !important; /* Words ko thora kareeb kiya taake wrap 2 lines mein hi ho */
      }
      .product-feature-list li div { 
        width: 16px !important; 
        height: 16px !important; 
        margin-top: 1px !important;
      }
      .product-feature-list li svg { 
        width: 9px !important; 
        height: 9px !important; 
      }
    }
  </style>
  {%- when 'trust_payment_badges' -%}
  <div class="custom-trust-badges-container" {{ block.shopify_attributes }} style="
    --padding-top: {{ block.settings.padding_top | default: 15 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 15 }}px;
  ">
    
    <div class="trust-guarantee-row">
      <span class="trust-badge-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
        </svg>
      </span>
      <span class="trust-guarantee-text">{{ block.settings.guarantee_text | default: '30-day money-back guarantee' }}</span>
    </div>

    <div class="trust-payment-icons-row">
      {%- if block.settings.show_amex -%}
        <div class="payment-card-badge amex-bg">Amex</div>
      {%- endif -%}
      
      {%- if block.settings.show_applepay -%}
        <div class="payment-card-badge applepay-bg"> Pay</div>
      {%- endif -%}

      {%- if block.settings.show_gpay -%}
        <div class="payment-card-badge gpay-bg"><span class="g-color">G</span> Pay</div>
      {%- endif -%}

      {%- if block.settings.show_mastercard -%}
        <div class="payment-card-badge mastercard-bg">
          <span class="mc-circles"></span>
        </div>
      {%- endif -%}

      {%- if block.settings.show_paypal -%}
        <div class="payment-card-badge paypal-bg">PayPal</div>
      {%- endif -%}

      {%- if block.settings.show_shop_pay -%}
        <div class="payment-card-badge shoppay-bg">shop<span>pay</span></div>
      {%- endif -%}

      {%- if block.settings.show_visa -%}
        <div class="payment-card-badge visa-bg">VISA</div>
      {%- endif -%}
    </div>

  </div>

  <style>
    .custom-trust-badges-container {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      gap: 12px !important;
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
      margin: 10px 0 !important;
      box-sizing: border-box !important;
    }

    /* Guarantee Row Styling */
    .trust-guarantee-row {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      color: #4F4F4F !important; /* Theme default adaptation */
    }

    .trust-badge-icon {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 18px !important;
      height: 18px !important;
      opacity: 0.85 !important;
    }

    .trust-badge-icon svg {
      width: 100% !important;
      height: 100% !important;
    }

    .trust-guarantee-text {
      font-size: 14px !important;
      font-weight: 400 !important;
      letter-spacing: 0.2px !important;
      font-family: var(--font-body-family), sans-serif !important;
    }

    /* Payment Badge Gateway Core Cards CSS Layout */
    .trust-payment-icons-row {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 8px !important;
    }

    .payment-card-badge {
      width: 44px !important;
      height: 26px !important;
      border-radius: 4px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      font-size: 10px !important;
      font-weight: 700 !important;
      box-sizing: border-box !important;
      user-select: none !important;
      border: 1px solid rgba(255,255,255,0.08) !important;
    }

    /* Card Specific Dynamic Brand Palette matching image styling */
    .amex-bg { background: #0070d2 !important; color: #ffffff !important; font-style: italic !important; font-size: 9px !important; }
    .applepay-bg { background: #ffffff !important; color: #000000 !important; font-size: 12px !important; border: 1px solid #000000 !important; }
    .gpay-bg { background: #ffffff !important; color: #5f6368 !important; border: 1px solid #dadce0 !important; }
    .gpay-bg .g-color { color: #4285F4 !important; margin-right: 1px; }
    
    .mastercard-bg { background: #ffffff !important; position: relative !important; border: 1px solid #e0e0e0 !important; }
    .mc-circles { display: block !important; width: 14px !important; height: 14px !important; background: #EB001B !important; border-radius: 50% !important; position: relative !important; }
    .mc-circles::after { content: "" !important; display: block !important; width: 14px !important; height: 14px !important; background: #FF5F00 !important; border-radius: 50% !important; position: absolute !important; left: 8px !important; top: 0 !important; opacity: 0.85 !important; }

    .paypal-bg { background: #ffffff !important; color: #003087 !important; font-style: italic !important; font-size: 9px !important; border: 1px solid #e0e0e0 !important; }
    .shoppay-bg { background: #5a31f4 !important; color: #ffffff !important; font-size: 9px !important; font-style: italic !important; }
    .shoppay-bg span { font-weight: 400 !important; }
    .visa-bg { background: #ffffff !important; color: #1a1f71 !important; font-style: italic !important; font-size: 11px !important; border: 1px solid #e0e0e0 !important; }

    /* 📱 Mobile Fine Tuning */
    @media screen and (max-width: 749px) {
      .trust-guarantee-text {
        font-size: 13px !important;
      }
      .payment-card-badge {
        width: 40px !important;
        height: 24px !important;
        font-size: 9px !important;
      }
    }
  </style>
  {%- when 'warning_callout_block' -%}
  <div class="warning-callout-block-wrapper" {{ block.shopify_attributes }} style="
    --bg-color: {{ block.settings.bg_color | default: '#fff5f5' }};
    --border-color: {{ block.settings.border_color | default: '#9b2c2c' }};
    --text-color: {{ block.settings.text_color | default: '#9b2c2c' }};
    --margin-top-desktop: {{ block.settings.margin_top_desktop | default: 20 }}px;
    --margin-bottom-desktop: {{ block.settings.margin_bottom_desktop | default: 20 }}px;
    --margin-top-mobile: {{ block.settings.margin_top_mobile | default: 14 }}px;
    --margin-bottom-mobile: {{ block.settings.margin_bottom_mobile | default: 14 }}px;
  ">
    <div class="wcb-container">
      <!-- Info SVG Icon -->
      <div class="wcb-icon-col">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="wcb-svg-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </div>
      
      <!-- Content Stack -->
      <div class="wcb-content-col">
        {%- if block.settings.heading_text != blank -%}
          <h4 class="wcb-heading">{{ block.settings.heading_text }}</h4>
        {%- endif -%}
        
        {%- if block.settings.body_text != blank -%}
          <div class="wcb-body">
            {{ block.settings.body_text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <style>
    .warning-callout-block-wrapper {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      margin-top: var(--margin-top-desktop) !important;
      margin-bottom: var(--margin-bottom-desktop) !important;
      background-color: var(--bg-color) !important;
      border: 1.2px dashed var(--border-color) !important;
      border-radius: 6px !important;
      padding: 10px 14px !important;
      text-align: left !important;
    }

    .wcb-container {
      display: flex !important;
      align-items: flex-start !important;
      gap: 10px !important;
    }

    .wcb-icon-col {
      flex-shrink: 0 !important;
      display: flex !important;
      align-items: center !important;
      margin-top: 1px !important;
    }

    .wcb-svg-icon {
      width: 18px !important;
      height: 18px !important;
      color: var(--text-color) !important;
    }

    .wcb-content-col {
      flex-grow: 1 !important;
    }

    .wcb-heading {
      margin: 0 0 2px 0 !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      font-size: 14px !important;
      font-weight: 700 !important;
      color: var(--text-color) !important;
      line-height: 1.2 !important;
      letter-spacing: 0 !important;
    }

    .wcb-body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      font-size: 12.5px !important;
      font-weight: 400 !important;
      color: var(--text-color) !important;
      line-height: 1.35 !important;
    }

    .wcb-body p {
      margin: 0 !important;
      color: var(--text-color) !important;
    }

    @media screen and (max-width: 749px) {
      .warning-callout-block-wrapper {
        margin-top: var(--margin-top-mobile) !important;
        margin-bottom: var(--margin-bottom-mobile) !important;
        padding: 6px 10px !important; /* Extremely tight padding for small viewports */
        border-radius: 4px !important;
        border-width: 1px !important; /* Thinner border layout on small screen footprints */
      }

      .wcb-container {
        gap: 6px !important; /* Brought icon closer to heading stack */
      }

      .wcb-icon-col {
        margin-top: 0px !important; /* Center metrics adjustment */
      }

      .wcb-svg-icon {
        width: 13px !important; /* Optimized micro icon dimensions */
        height: 13px !important;
        stroke-width: 3px !important; /* Enhanced readability at smaller aspect */
      }

      .wcb-heading {
        font-size: 11.5px !important; /* Micro size structure for headers */
        margin-bottom: 0px !important;
        line-height: 1.15 !important;
      }

      .wcb-body {
        font-size: 10.5px !important; /* Micro typography frame for extreme mobile efficiency */
        line-height: 1.25 !important;
      }
    }
  </style>
  {%- when 'customer_social_proof' -%}
  <div class="elare-trust-block-container" {{ block.shopify_attributes }} style="
    --padding-top: {{ block.settings.padding_top | default: 12 }}px;
    --padding-bottom: {{ block.settings.padding_bottom | default: 12 }}px;
    --bg-color: {{ block.settings.background_color | default: '#f4f6f9' }};
    --text-color: {{ block.settings.text_color | default: '#111111' }};
  ">
    
    <div class="elare-trust-card-wrapper">
      
      <div class="elare-avatar-cluster">
        <div class="elare-avatar-slot slot-1">
          {%- if block.settings.avatar_1 != blank -%}
            <img src="{{ block.settings.avatar_1 | image_url: width: 100 }}" alt="Customer 1" loading="lazy">
          {%- else -%}
            <div class="avatar-fallback-placeholder" style="background-image: url('https://cdn.shopify.com/s/files/1/0306/6419/6231/files/dtc-m1.jpg?v=1710000001');"></div>
          {%- endif -%}
        </div>

        <div class="elare-avatar-slot slot-2">
          {%- if block.settings.avatar_2 != blank -%}
            <img src="{{ block.settings.avatar_2 | image_url: width: 100 }}" alt="Customer 2" loading="lazy">
          {%- else -%}
            <div class="avatar-fallback-placeholder" style="background-image: url('https://cdn.shopify.com/s/files/1/0306/6419/6231/files/dtc-w1.jpg?v=1710000002');"></div>
          {%- endif -%}
        </div>

        <div class="elare-avatar-slot slot-3">
          {%- if block.settings.avatar_3 != blank -%}
            <img src="{{ block.settings.avatar_3 | image_url: width: 100 }}" alt="Customer 3" loading="lazy">
          {%- else -%}
            <div class="avatar-fallback-placeholder" style="background-image: url('https://cdn.shopify.com/s/files/1/0306/6419/6231/files/dtc-m2.jpg?v=1710000003');"></div>
          {%- endif -%}
          
          <span class="elare-verified-checkmark">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 13l4 4L19 7" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>

      <div class="elare-message-content">
        <h4 class="elare-main-heading">{{ block.settings.headline | default: 'Trusted by 100K+ customers' }}</h4>
        <p class="elare-sub-body">{{ block.settings.subtext | default: 'who choose Elaré for consistent, long-term wellness support.' }}</p>
      </div>

    </div>

  </div>

  <style>
    .elare-trust-block-container {
      width: 100% !important;
      max-width: 100% !important;
      padding-top: var(--padding-top) !important;
      padding-bottom: var(--padding-bottom) !important;
      box-sizing: border-box !important;
      display: flex !important;
      justify-content: flex-start !important;
      overflow: visible !important; 
    }

    /* Desktop Styles */
    .elare-trust-card-wrapper {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      background: var(--bg-color) !important;
