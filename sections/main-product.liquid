        </div>
        <div class="exc-time-box">
          <span class="exc-time-num js-timer-minutes">00</span>
          <span class="exc-time-lbl">MIN</span>
        </div>
        <div class="exc-time-box">
          <span class="exc-time-num js-timer-seconds">00</span>
          <span class="exc-time-lbl">SEG</span>
        </div>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const timerContainer = document.querySelector('.exc-countdown-timer-clock');
      if (!timerContainer) return;

      let hours = parseInt(timerContainer.getAttribute('data-hours')) || 0;
      let minutes = parseInt(timerContainer.getAttribute('data-minutes')) || 0;
      let seconds = parseInt(timerContainer.getAttribute('data-seconds')) || 0;

      let totalSeconds = (hours * 3600) + (minutes * 60) + seconds;

      const hrsEl = timerContainer.querySelector('.js-timer-hours');
      const minEl = timerContainer.querySelector('.js-timer-minutes');
      const secEl = timerContainer.querySelector('.js-timer-seconds');

      function updateClock() {
        if (totalSeconds <= 0) {
          hrsEl.textContent = "00";
          minEl.textContent = "00";
          secEl.textContent = "00";
          clearInterval(countdownInterval);
          return;
        }

        let h = Math.floor(totalSeconds / 3600);
        let m = Math.floor((totalSeconds % 3600) / 60);
        let s = totalSeconds % 60;

        hrsEl.textContent = h < 10 ? "0" + h : h;
        minEl.textContent = m < 10 ? "0" + m : m;
        secEl.textContent = s < 10 ? "0" + s : s;

        totalSeconds--;
      }

      updateClock();
      const countdownInterval = setInterval(updateClock, 1000);
    });
  </script>

