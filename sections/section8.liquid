<style>
  .xwhy-wrapper {
    background-color: #000000;
    padding: 64px 24px 56px;
    border-bottom: 1px solid #ffffff;
  }

  .xwhy-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .xwhy-heading {
    text-align: center;
    font-size: 34px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.3;
    max-width: 900px;
    margin: 0 auto 48px;
  }

  .xwhy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
  }

  .xwhy-item {
    padding: 32px;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
  }

  .xwhy-number {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #999999;
    margin: 0 0 16px;
  }

  .xwhy-title {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 10px;
  }

  .xwhy-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #cccccc;
    margin: 0;
  }

  .xwhy-cta {
    text-align: center;
    margin-top: 44px;
  }

  .xwhy-btn {
    display: inline-block;
    background-color: #ffffff;
    color: #000000;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 999px;
  }

  @media (max-width: 900px) {
    .xwhy-wrapper {
      padding: 36px 16px 32px;
    }

    .xwhy-heading {
      font-size: 22px;
      margin-bottom: 28px;
    }

    .xwhy-grid {
      grid-template-columns: 1fr;
    }

    .xwhy-item {
      padding: 22px;
    }

    .xwhy-title {
      font-size: 16px;
    }

    .xwhy-desc {
      font-size: 13px;
    }

    .xwhy-cta {
      margin-top: 28px;
    }

    .xwhy-btn {
      font-size: 13px;
      padding: 14px 30px;
    }
  }
</style>

<div class="xwhy-wrapper">
  <div class="xwhy-inner">
    <h2 class="xwhy-heading">{{ section.settings.heading }}</h2>

    <div class="xwhy-grid">
      {% for block in section.blocks %}
        <div class="xwhy-item" {{ block.shopify_attributes }}>
          <p class="xwhy-number">{{ block.settings.number }}</p>
          <p class="xwhy-title">{{ block.settings.title }}</p>
          <p class="xwhy-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="xwhy-cta">
        <a href="{{ section.settings.button_link }}" class="xwhy-btn">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Why It Works Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Por qué Excalvo Shampoo Clínico para el Crecimiento del Cabello funciona cuando todo lo demás te falló."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Comprar Ahora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why It Works Grid",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "number": "01",
            "title": "Dosis Probadas en Ensayos",
            "description": "Igualamos las concentraciones exactas usadas en estudios revisados — nunca infradosificadas para abaratar."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "02",
            "title": "Ataca la Verdadera Causa",
            "description": "Neutraliza la actividad del DHT en el folículo en lugar de tapar el adelgazamiento con rellenos cosméticos."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "03",
            "title": "Reconstruye Desde la Raíz",
            "description": "Nutrientes bioactivos llegan a la papila dérmica para que el cabello nuevo salga más grueso, denso y bien anclado."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "04",
            "title": "Conserva Lo Que Crece",
            "description": "Sin hormonas, sin Minoxidil, sin caída de rebote. Pausa la rutina y tu progreso se queda contigo."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "05",
            "title": "Hecho en un Laboratorio Certificado",
            "description": "Producido en una planta registrada por la FDA, certificada GMP, con pruebas de pureza por terceros en cada lote."
          }
        },
        {
          "type": "reason",
          "settings": {
            "number": "06",
            "title": "Para Todo Tipo de Adelgazamiento",
            "description": "Diseñado para caída genética, hormonal, por estrés y postparto — suave para hombres y mujeres."
          }
        }
      ]
    }
  ]
}
{% endschema %}