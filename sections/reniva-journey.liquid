{% comment %} reniva-journey.liquid — wellness journey timeline {% endcomment %}
<section class="rv-journey" id="rv-journey-{{ section.id }}">
  <div class="rv-journey__inner">
    <div class="rv-journey__left">
      <div class="rv-journey__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              class: 'rv-journey__img',
              sizes: '(min-width: 990px) 480px, 90vw',
              widths: '400, 600, 800, 900'
          }}
        {% else %}
          <div class="rv-journey__placeholder" role="img" aria-label="Lifestyle image placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="16" rx="2"/>
              <circle cx="9" cy="10" r="2"/>
              <path d="M3 17l5-5 4 4 3-3 6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Add lifestyle photo here</span>
          </div>
        {% endif %}
        <span class="rv-journey__wordmark">{{ section.settings.wordmark | default: 'RENIVA' }}</span>
      </div>

      <h2 class="rv-journey__headline">{{ section.settings.headline }}</h2>
      {% if section.settings.subheadline != blank %}
        <p class="rv-journey__subheadline">{{ section.settings.subheadline }}</p>
      {% endif %}

      <a href="{{ section.settings.cta_link | default: '#rv-add-to-cart' }}" class="rv-journey__cta">
        {{ section.settings.cta_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      {% if section.settings.guarantee_text != blank %}
        <p class="rv-journey__guarantee">{{ section.settings.guarantee_text }}</p>
      {% endif %}
    </div>

    <div class="rv-journey__right">
      <div class="rv-journey__timeline">
        {% for block in section.blocks %}
          <div class="rv-journey__stage" {{ block.shopify_attributes }}>
            <span class="rv-journey__dot" aria-hidden="true"></span>
            <div class="rv-journey__stage-card">
              <div class="rv-journey__stage-header">
                <span class="rv-journey__stage-week">{{ block.settings.week_label }}</span>
                <span class="rv-journey__stage-title">{{ block.settings.title }}</span>
              </div>
              <ul class="rv-journey__checklist">
                {% if block.settings.checklist_item_1 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {{ block.settings.checklist_item_1 }}
                  </li>
                {% endif %}
                {% if block.settings.checklist_item_2 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {{ block.settings.checklist_item_2 }}
                  </li>
                {% endif %}
                {% if block.settings.checklist_item_3 != blank %}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {{ block.settings.checklist_item_3 }}
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.footnote != blank %}
        <p class="rv-journey__footnote">{{ section.settings.footnote }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #rv-journey-{{ section.id }} {
    background: #FFF9EF;
  }

  #rv-journey-{{ section.id }} .rv-journey__inner {
    display: grid;
    grid-template-columns: 1fr;
  }

  #rv-journey-{{ section.id }} .rv-journey__left {
    background: #3E2A1E;
    color: #F3E4C8;
    padding: 48px 20px;
  }

  #rv-journey-{{ section.id }} .rv-journey__media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 28px;
  }

  #rv-journey-{{ section.id }} .rv-journey__img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  #rv-journey-{{ section.id }} .rv-journey__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    aspect-ratio: 4 / 3;
    border: 2px dashed rgba(198, 155, 59, 0.4);
    color: #D8C39C;
    font-size: 13px;
    text-align: center;
    padding: 20px;
  }

  #rv-journey-{{ section.id }} .rv-journey__placeholder svg {
    width: 40px;
    height: 40px;
    opacity: 0.7;
  }

  #rv-journey-{{ section.id }} .rv-journey__wordmark {
    position: absolute;
    left: 18px;
    bottom: 16px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #FFF9EF;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  #rv-journey-{{ section.id }} .rv-journey__headline {
    font-size: clamp(26px, 4.5vw, 36px);
    font-weight: 800;
    margin: 0 0 14px;
    letter-spacing: -0.4px;
    line-height: 1.18;
  }

  #rv-journey-{{ section.id }} .rv-journey__subheadline {
    font-size: 15.5px;
    line-height: 1.65;
    color: #D8C39C;
    margin: 0 0 28px;
    max-width: 480px;
  }

  #rv-journey-{{ section.id }} .rv-journey__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15.5px;
    padding: 15px 28px;
    border-radius: 999px;
    background: #C69B3B;
    color: #3E2A1E;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-journey-{{ section.id }} .rv-journey__cta svg {
    width: 16px;
    height: 16px;
  }

  #rv-journey-{{ section.id }} .rv-journey__cta:hover {
    background: #E4C874;
    transform: translateY(-1px);
  }

  #rv-journey-{{ section.id }} .rv-journey__guarantee {
    margin: 18px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #D8C39C;
  }

  #rv-journey-{{ section.id }} .rv-journey__right {
    background: #FFFFFF;
    padding: 48px 20px;
  }

  #rv-journey-{{ section.id }} .rv-journey__timeline {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
    padding-left: 28px;
  }

  #rv-journey-{{ section.id }} .rv-journey__timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 5px;
    width: 2px;
    background: linear-gradient(180deg, #C69B3B, #E7D6AF);
  }

  #rv-journey-{{ section.id }} .rv-journey__stage {
    position: relative;
    margin-bottom: 24px;
  }

  #rv-journey-{{ section.id }} .rv-journey__stage:last-child {
    margin-bottom: 0;
  }

  #rv-journey-{{ section.id }} .rv-journey__dot {
    position: absolute;
    left: -28px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #C69B3B;
    border: 3px solid #FFF9EF;
    box-shadow: 0 0 0 2px #C69B3B;
  }

  #rv-journey-{{ section.id }} .rv-journey__stage-card {
    background: #FBF3E4;
    border: 1px solid #EEDFC0;
    border-radius: 16px;
    overflow: hidden;
  }

  #rv-journey-{{ section.id }} .rv-journey__stage-header {
    background: linear-gradient(90deg, #C69B3B, #A87F2A);
    color: #FFF9EF;
    padding: 12px 18px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  #rv-journey-{{ section.id }} .rv-journey__stage-week {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
  }

  #rv-journey-{{ section.id }} .rv-journey__stage-title {
    font-size: 16.5px;
    font-weight: 800;
  }

  #rv-journey-{{ section.id }} .rv-journey__checklist {
    list-style: none;
    margin: 0;
    padding: 14px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  #rv-journey-{{ section.id }} .rv-journey__checklist li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: #3E2A1E;
  }

  #rv-journey-{{ section.id }} .rv-journey__checklist svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: #A87F2A;
  }

  #rv-journey-{{ section.id }} .rv-journey__footnote {
    max-width: 480px;
    margin: 24px auto 0;
    font-size: 11.5px;
    color: #9C8367;
  }

  @media screen and (min-width: 990px) {
    #rv-journey-{{ section.id }} .rv-journey__inner {
      grid-template-columns: 1fr 1fr;
    }
    #rv-journey-{{ section.id }} .rv-journey__left {
      padding: 88px 56px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #rv-journey-{{ section.id }} .rv-journey__right {
      padding: 88px 56px;
      display: flex;
      align-items: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Journey",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark overlay text",
      "default": "RENIVA"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Your Wellness Journey with Reniva"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Reniva® is built for daily care, not overnight miracles. Here's how your hair tends to change once it becomes part of your routine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Start My Journey →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Defaults to the Add to Cart section (#rv-add-to-cart) if left blank."
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Small guarantee text",
      "default": "🛡 30-Day Money-Back Guarantee"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "†These statements have not been evaluated by the Food and Drug Administration."
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Timeline stage",
      "settings": [
        {
          "type": "text",
          "id": "week_label",
          "label": "Week label",
          "default": "Week 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Early Shifts"
        },
        {
          "type": "text",
          "id": "checklist_item_1",
          "label": "Checklist item 1",
          "default": "Scalp starts to feel calmer†"
        },
        {
          "type": "text",
          "id": "checklist_item_2",
          "label": "Checklist item 2",
          "default": "Less irritation with each wash†"
        },
        {
          "type": "text",
          "id": "checklist_item_3",
          "label": "Checklist item 3",
          "default": "Hair feels cleaner, lighter†"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reniva Journey",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "week_label": "Week 1",
            "title": "Early Shifts",
            "checklist_item_1": "Scalp starts to feel calmer†",
            "checklist_item_2": "Less irritation with each wash†",
            "checklist_item_3": "Hair feels cleaner, lighter†"
          }
        },
        {
          "type": "stage",
          "settings": {
            "week_label": "Week 2",
            "title": "Reduced Fall",
            "checklist_item_1": "Noticeably less hair in the shower drain†",
            "checklist_item_2": "Roots start to feel stronger†",
            "checklist_item_3": "Scalp oil production feels more balanced†"
          }
        },
        {
          "type": "stage",
          "settings": {
            "week_label": "Week 3",
            "title": "Strength & Shine",
            "checklist_item_1": "Hair feels softer and more resilient†",
            "checklist_item_2": "Breakage starts to visibly reduce†",
            "checklist_item_3": "Natural shine begins to return†"
          }
        },
        {
          "type": "stage",
          "settings": {
            "week_label": "Week 4+",
            "title": "Long-Term Balance",
