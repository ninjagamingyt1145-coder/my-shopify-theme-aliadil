<style>
  .xticker-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 10px 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .xticker-track {
    display: inline-flex;
    align-items: center;
    animation: xticker-scroll {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  .xticker-wrapper:hover .xticker-track {
    animation-play-state: {{ section.settings.pause_on_hover | default: 'paused' }};
  }

  .xticker-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 32px;
    font-size: {{ section.settings.font_size }}px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .xticker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ section.settings.text_color }};
    flex-shrink: 0;
    opacity: 0.8;
  }

  @keyframes xticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 600px) {
    .xticker-wrapper {
      padding: 6px 0;
    }

    .xticker-item {
      font-size: {{ section.settings.font_size | minus: 2 }}px;
      padding: 0 16px;
      gap: 7px;
    }

    .xticker-dot {
      width: 4px;
      height: 4px;
    }
  }
</style>

<div class="xticker-wrapper">
  <div class="xticker-track" id="xticker-track">
    {% for block in section.blocks %}
      <span class="xticker-item" {{ block.shopify_attributes }}>
        <span class="xticker-dot"></span>
        {{ block.settings.text }}
      </span>
    {% endfor %}
    {% for block in section.blocks %}
      <span class="xticker-item" aria-hidden="true">
        <span class="xticker-dot"></span>
        {{ block.settings.text }}
      </span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling Ticker",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#8b1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size (px)",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (lower = faster)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "options": [
        { "value": "paused", "label": "Yes" },
        { "value": "running", "label": "No" }
      ],
      "default": "paused"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ticker item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Free Bottles on Order 2+" } },
        { "type": "item", "settings": { "text": "90-Day Money Back Guarantee" } },
        { "type": "item", "settings": { "text": "Over 55,000+ Happy Customers" } },
        { "type": "item", "settings": { "text": "Zero Stimulants or Jitters" } },
        { "type": "item", "settings": { "text": "4000MG Per Serving" } },
        { "type": "item", "settings": { "text": "Liquid Formula for Fast Absorption" } }
      ]
    }
  ]
}
{% endschema %}