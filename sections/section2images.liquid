<style>
  .xstack-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 64px 0 48px;
  }

  .xstack-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .xstack-header {
    text-align: center;
    margin-bottom: 32px;
    padding: 0 24px;
  }

  .xstack-heading {
    font-size: 42px;
    font-weight: 900;
    color: #1a1a1a;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .xstack-heading-underline {
    display: block;
    width: 60px;
    height: 3px;
    background-color: #c0392b;
    margin: 8px auto 16px;
    border-radius: 2px;
  }

  .xstack-subheading {
    font-size: 16px;
    color: #666666;
    margin: 0;
  }

  .xstack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .xstack-card {
    background-color: {{ section.settings.card_color }};
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 160px;
  }

  .xstack-card-image {
    flex-shrink: 0;
    width: 130px;
    padding: 10px 0 10px 10px;
    box-sizing: border-box;
  }

  .xstack-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .xstack-card-content {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .xstack-card-title {
    font-size: 17px;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.3;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .xstack-card-icon {
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
  }

  .xstack-card-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .xstack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .xstack-wrapper {
      padding: 40px 12px 32px;
    }

    .xstack-header {
      padding: 0;
    }

    .xstack-heading {
      font-size: 28px;
    }

    .xstack-subheading {
      font-size: 14px;
    }

    .xstack-grid {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .xstack-card-image {
      width: 110px;
      padding: 8px 0 8px 8px;
    }

    .xstack-card-content {
      padding: 16px 14px;
    }

    .xstack-card-title {
      font-size: 15px;
    }

    .xstack-card-desc {
      font-size: 13px;
    }
  }
</style>

<div class="xstack-wrapper">
  <div class="xstack-inner">
    <div class="xstack-header">
      <h2 class="xstack-heading">{{ section.settings.heading }}</h2>
      <span class="xstack-heading-underline"></span>
      <p class="xstack-subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="xstack-grid">
      {% for block in section.blocks %}
        <div class="xstack-card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="xstack-card-image">
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            </div>
          {% endif %}
          <div class="xstack-card-content">
            <p class="xstack-card-title">
              {% if block.settings.icon != blank %}
                <span class="xstack-card-icon">{{ block.settings.icon }}</span>
              {% endif %}
              {{ block.settings.title }}
            </p>
            <p class="xstack-card-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Elite Burn Stack",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background color",
      "default": "#f0ece3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Elite Burn Stack"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Replaces multiple supplements. Saves you time, money, and guesswork."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "🔥"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fat Burn"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Convert stubborn fat into energy with L-Carnitine + BAIBA."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Elite Burn Stack",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🔥",
            "title": "Fat Burn",
            "description": "Convert stubborn fat into energy with L-Carnitine + BAIBA."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🚀",
            "title": "Energy Boost",
            "description": "Fuel your workouts and daily performance without caffeine or crash."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🚀",
            "title": "Focus & Clarity",
            "description": "Stay sharp with L-Theanine for clean mental energy all day."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🌶️",
            "title": "Thermogenic Kick",
            "description": "Increase calorie burn with Grains of Paradise (BAT activator)."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🛡️",
            "title": "Metabolic Support",
            "description": "Stabilize cravings and blood sugar with GBEEC + Chromium."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "💪",
            "title": "Lean Body Support",
            "description": "Protect muscle, burn fat all in one stimulant free dose."
          }
        }
      ]
    }
  ]
}
{% endschema %}