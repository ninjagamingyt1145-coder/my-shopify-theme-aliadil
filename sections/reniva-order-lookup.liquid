{% comment %}
  reniva-order-lookup.liquid
  Order number + email lookup form. Shopify doesn't expose a public "look up by
  order number + email" endpoint without a tracking app, so submitting this form
  takes the customer to Shopify's native order status area (account login / order
  history) — the closest native equivalent — while the note below sets honest
  expectations about the fastest way to check status.
{% endcomment %}
<section class="rv-lookup" id="rv-lookup-{{ section.id }}">
  <div class="rv-lookup__inner">
    <form class="rv-lookup__form" data-rv-lookup-form action="{{ routes.account_login_url }}" method="get">
      <div class="rv-lookup__row">
        <div class="rv-lookup__field">
          <label for="RvOrderNumber-{{ section.id }}">Order number</label>
          <input
            type="text"
            id="RvOrderNumber-{{ section.id }}"
            name="order_number"
            placeholder="e.g. #1234"
            autocomplete="off"
          >
        </div>
        <div class="rv-lookup__field">
          <label for="RvOrderEmail-{{ section.id }}">Email</label>
          <input
            type="email"
            id="RvOrderEmail-{{ section.id }}"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
          >
        </div>
      </div>
      <button type="submit" class="rv-lookup__submit">{{ section.settings.button_label }}</button>
      {% if section.settings.helper_text != blank %}
        <p class="rv-lookup__helper">{{ section.settings.helper_text }}</p>
      {% endif %}
    </form>
  </div>
</section>

{% style %}
  #rv-lookup-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-cream-deep: #F3E4C8;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;
    --rv-brown-soft: #6B4F3B;
    --rv-border: #E7D6AF;

    background: #FFF9EF;
    padding: 40px 20px 0;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__inner {
    max-width: 560px;
    margin: 0 auto;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__form {
    background: #FFFDF8;
    border: 1px solid var(--rv-border);
    border-radius: 20px;
    padding: 28px 22px;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 18px;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__field label {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rv-brown-soft);
    margin-bottom: 6px;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__field input {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    font-size: 15px;
    color: var(--rv-brown);
    background: #FFFFFF;
    border: 1px solid var(--rv-border);
    border-radius: 12px;
    padding: 12px 14px;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__field input:focus {
    outline: none;
    border-color: var(--rv-gold);
    box-shadow: 0 0 0 3px rgba(198, 155, 59, 0.18);
  }

  #rv-lookup-{{ section.id }} .rv-lookup__submit {
    width: 100%;
    border: none;
    border-radius: 999px;
    background: var(--rv-gold);
    color: #FFF9EF;
    font-weight: 700;
    font-size: 16px;
    padding: 15px 24px;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-lookup-{{ section.id }} .rv-lookup__submit:hover {
    background: var(--rv-gold-dark);
    transform: translateY(-1px);
  }

  #rv-lookup-{{ section.id }} .rv-lookup__helper {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--rv-brown-soft);
    text-align: center;
  }

  @media screen and (min-width: 600px) {
    #rv-lookup-{{ section.id }} .rv-lookup__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 750px) {
    #rv-lookup-{{ section.id }} {
      padding: 56px 40px 0;
    }
    #rv-lookup-{{ section.id }} .rv-lookup__form {
      padding: 36px 40px;
    }
  }
{% endstyle %}

<script>
  (function () {
    function initRvLookup(form) {
      if (!form || form.dataset.rvInit === 'true') return;
      form.dataset.rvInit = 'true';
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        window.location.href = form.getAttribute('action');
      });
    }

    function initAll() {
      document.querySelectorAll('[data-rv-lookup-form]').forEach(initRvLookup);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var form = event.target.querySelector('[data-rv-lookup-form]');
      if (form) {
        form.dataset.rvInit = 'false';
        initRvLookup(form);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Reniva Order Lookup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Check Order Status"
    },
    {
      "type": "textarea",
      "id": "helper_text",
      "label": "Helper text",
      "default": "We don't have a live tracking app connected yet. Submitting this form takes you to your account's order history — for the fastest update, check the shipping confirmation email we sent you."
    }
  ],
  "presets": [
    {
      "name": "Reniva Order Lookup"
    }
  ]
}
{% endschema %}
