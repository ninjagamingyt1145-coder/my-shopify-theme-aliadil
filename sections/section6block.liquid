<style>
  .xsci-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 72px 24px 80px;
  }

  .xsci-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .xsci-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .xsci-heading {
    font-size: 44px;
    font-weight: 900;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 12px;
    line-height: 1.15;
  }

  .xsci-subheading {
    font-size: 16px;
    color: #777777;
    margin: 0 0 16px;
  }

  .xsci-divider {
    display: block;
    width: 60px;
    height: 3px;
    background: linear-gradient(to right, #8b1a1a, #c0392b);
    margin: 0 auto;
    border-radius: 2px;
  }

  .xsci-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .xsci-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 32px 36px;
    display: flex;
    align-items: flex-start;
    gap: 28px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .xsci-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .xsci-card-number {
    font-size: 52px;
    font-weight: 900;
    color: {{ section.settings.number_color }};
    line-height: 1;
    flex-shrink: 0;
    width: 40px;
    text-align: center;
    margin-top: 4px;
  }

  .xsci-card-body {
    flex: 1;
  }

  .xsci-card-title {
    font-size: 17px;
    font-weight: 900;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .xsci-card-desc {
    font-size: 15px;
    line-height: 1.7;
    color: #555555;
    margin: 0;
  }

  @media (max-width: 640px) {
    .xsci-wrapper {
      padding: 48px 16px 56px;
    }

    .xsci-heading {
      font-size: 26px;
    }

    .xsci-subheading {
      font-size: 14px;
    }

    .xsci-header {
      margin-bottom: 32px;
    }

    .xsci-card {
      padding: 24px 22px;
      gap: 20px;
      border-radius: 16px;
    }

    .xsci-card-number {
      font-size: 38px;
      width: 30px;
    }

    .xsci-card-title {
      font-size: 15px;
    }

    .xsci-card-desc {
      font-size: 13px;
    }

    .xsci-list {
      gap: 14px;
    }
  }
</style>

<div class="xsci-wrapper">
  <div class="xsci-inner">
    <div class="xsci-header">
      <h2 class="xsci-heading">{{ section.settings.heading }}</h2>
      <p class="xsci-subheading">{{ section.settings.subheading }}</p>
      <span class="xsci-divider"></span>
    </div>

    <div class="xsci-list">
      {% for block in section.blocks %}
        <div class="xsci-card" data-xsci-card {{ block.shopify_attributes }}>
          <span class="xsci-card-number">{{ forloop.index }}</span>
          <div class="xsci-card-body">
            <p class="xsci-card-title">{{ block.settings.title }}</p>
            <p class="xsci-card-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    function initXsci() {
      var cards = document.querySelectorAll('[data-xsci-card]');
      if (!cards.length) return;

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var card = entry.target;
              var index = Array.from(cards).indexOf(card);
              setTimeout(function () {
                card.classList.add('is-visible');
              }, index * 150);
              observer.unobserve(card);
            }
          });
        }, { threshold: 0.15 });

        cards.forEach(function (card) {
          observer.observe(card);
        });
      } else {
        cards.forEach(function (card) {
          card.classList.add('is-visible');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initXsci);
    } else {
      initXsci();
    }

    document.addEventListener('shopify:section:load', initXsci);
  })();
</script>

{% schema %}
{
  "name": "Science Steps",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#e8e5de"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#8b1a1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Science Behind The Results"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "How L-Carnitine transforms your body at the cellular level"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mobilize Fat Stores"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "L-Carnitine grabs fatty acids from your fat cells and prepares them for transport."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Mobilize Fat Stores",
            "description": "L-Carnitine grabs fatty acids from your fat cells and prepares them for transport."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Transport To Mitochondria",
            "description": "Acts like a shuttle bus, carrying fat directly to where it gets burned for energy."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Convert Fat To Energy",
            "description": "Your mitochondria burn the fat for clean, sustained energy that lasts all day."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Preserve Lean Muscle",
            "description": "By using fat as the primary fuel source, L-Carnitine helps protect your hard-earned muscle tissue."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Accelerate Recovery",
            "description": "L-Carnitine reduces muscle damage and soreness, helping you recover faster between workouts."
          }
        }
      ]
    }
  ]
}
{% endschema %}