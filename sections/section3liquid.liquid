<style>
  .xingr-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 64px 24px 0;
  }

  .xingr-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .xingr-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .xingr-heading {
    font-size: 38px;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .xingr-subheading {
    font-size: 16px;
    color: #aaaaaa;
    margin: 0;
  }

  .xingr-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .xingr-card {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1.5px solid rgba(180, 30, 30, 0.35);
    padding: 22px 28px;
    box-shadow: 0 0 0 1px rgba(180, 30, 30, 0.08);
  }

  .xingr-card-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .xingr-card-icon {
    font-size: 22px;
    line-height: 1;
    flex-shrink: 0;
  }

  .xingr-card-title {
    font-size: 18px;
    font-weight: 800;
    color: #b91c1c;
    margin: 0;
    line-height: 1.2;
  }

  .xingr-card-desc {
    font-size: 15px;
    line-height: 1.65;
    color: #333333;
    margin: 0;
  }

  .xingr-card-desc strong {
    color: #1a1a1a;
    font-weight: 800;
  }

  .xingr-footer {
    text-align: center;
    padding: 20px 24px;
    margin-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .xingr-footer-text {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.04em;
    margin: 0;
  }

  @media (max-width: 640px) {
    .xingr-wrapper {
      padding: 40px 16px 0;
    }

    .xingr-heading {
      font-size: 26px;
    }

    .xingr-subheading {
      font-size: 14px;
    }

    .xingr-card {
      padding: 18px 20px;
    }

    .xingr-card-title {
      font-size: 16px;
    }

    .xingr-card-desc {
      font-size: 14px;
    }

    .xingr-list {
      gap: 12px;
    }

    .xingr-footer-text {
      font-size: 9px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
      letter-spacing: 0.01em;
    }
  }
</style>

<div class="xingr-wrapper">
  <div class="xingr-inner">

    {% if section.settings.heading != blank %}
      <div class="xingr-header">
        <h2 class="xingr-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="xingr-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="xingr-list">
      {% for block in section.blocks %}
        <div class="xingr-card" {{ block.shopify_attributes }}>
          <div class="xingr-card-title-row">
            {% if block.settings.icon != blank %}
              <span class="xingr-card-icon">{{ block.settings.icon }}</span>
            {% endif %}
            <p class="xingr-card-title">{{ block.settings.title }}</p>
          </div>
          <p class="xingr-card-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>

  </div>

  {% if section.settings.footer_text != blank %}
    <div class="xingr-footer">
      <p class="xingr-footer-text">{{ section.settings.footer_text }}</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Ingredients List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every ingredient is clinically dosed and research-backed."
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Stimulant-Free • Triple-Blend Formula • 4000MG Dose"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient name",
          "default": "L-Carnitine"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (use <strong> for bold)",
          "default": "<strong>Converts fat to fuel</strong> and boosts muscular endurance — the foundation of effective fat-burning."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients List",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "icon": "⚡",
            "title": "L-Carnitine",
            "description": "<strong>Converts fat to fuel</strong> and boosts muscular endurance — the foundation of effective fat-burning."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "🚗",
            "title": "GBEEC",
            "description": "<strong>Amplifies carnitine activity</strong> and accelerates metabolic output for faster results."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "💥",
            "title": "BAIBA",
            "description": "Triggers <strong>fat browning</strong>, helping your body burn more calories by activating metabolically active fat cells."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "🔥",
            "title": "Grains of Paradise",
            "description": "A natural <strong>thermogenic kicker</strong> that stimulates Brown Adipose Tissue (BAT) to unlock stored fat."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "icon": "🧠",
            "title": "L-Theanine",
            "description": "Enhances <strong>laser focus</strong> without jitters — perfect for stimulant-sensitive users or stackers."
          }
        }
      ]
    }
  ]
}
{% endschema %}