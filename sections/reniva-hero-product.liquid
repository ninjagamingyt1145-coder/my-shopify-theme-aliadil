<script>
  (function () {
    function initRvThumbs(root) {
      var thumbWrap = root.querySelector('[data-rv-thumbs]');
      if (!thumbWrap) return;
      var mainImg = root.querySelector('.rv-hero__main-media img, .rv-hero__main-media .rv-placeholder');
      var thumbs = thumbWrap.querySelectorAll('.rv-hero__thumb');

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          thumbs.forEach(function (t) { t.classList.toggle('is-active', t === thumb); });
          var full = thumb.getAttribute('data-full');
          var alt = thumb.getAttribute('data-alt');
          if (mainImg && mainImg.tagName === 'IMG' && full) {
            mainImg.src = full;
            mainImg.removeAttribute('srcset');
            if (alt) mainImg.alt = alt;
          }
        });
      });
    }

    function initRvBundle(root) {
      if (!root || root.dataset.rvInit === 'true') return;
      root.dataset.rvInit = 'true';

      var radios = root.querySelectorAll('.rv-bundle__radio');
      var totalPriceEls = root.querySelectorAll('[data-rv-total-price]');
      var giftsWrap = root.querySelector('[data-rv-gifts]');

      function selectTier(radio) {
        radios.forEach(function (r) {
          var label = root.querySelector('label[for="' + r.id + '"]');
          if (label) label.classList.toggle('is-selected', r === radio);
        });

        var price = radio.getAttribute('data-total-price');
        if (price) {
          totalPriceEls.forEach(function (el) {
            el.textContent = price;
          });
        }

        if (giftsWrap) {
          var shippingGift = giftsWrap.querySelector('[data-gift="shipping"]');
          var bonusGift = giftsWrap.querySelector('[data-gift="bonus"]');
          if (shippingGift) {
            shippingGift.classList.toggle('is-unlocked', radio.getAttribute('data-free-shipping') === 'true');
          }
          if (bonusGift) {
            var unlocked = radio.getAttribute('data-bonus-gift') === 'true';
            bonusGift.classList.toggle('is-unlocked', unlocked);
            var label = bonusGift.querySelector('[data-gift-label]');
            var bonusLabel = radio.getAttribute('data-bonus-gift-label');
            if (label && bonusLabel) label.textContent = bonusLabel;
          }
        }
      }

      radios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          if (radio.checked) selectTier(radio);
        });
      });

      var checked = root.querySelector('.rv-bundle__radio:checked');
      if (checked) selectTier(checked);
    }

    function initAll(scope) {
      var root = scope || document;
      root.querySelectorAll('.rv-hero__gallery').forEach(initRvThumbs);
      root.querySelectorAll('rv-bundle-tiers').forEach(initRvBundle);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(document); });
    } else {
      initAll(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      var bundle = event.target.querySelector('rv-bundle-tiers');
      if (bundle) bundle.dataset.rvInit = 'false';
      initAll(event.target);
    });
  })();
</script>

