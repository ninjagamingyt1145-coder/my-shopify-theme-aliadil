{% comment %}
  reniva-hero-product.liquid
  Merged hero + tiered bundle pricing for the Reniva product template, so the
  full buying experience (gallery, price, tiers, add to cart) is visible
  together without scrolling to a separate section. Uses the real product's
  variant id so Add to Cart works with the theme's cart drawer — selecting a
  bundle tier sets the native "quantity" field submitted with the product
  form, so the correct quantity of the real product variant is added.
{% endcomment %}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign preselected_block = null
  assign preselected_block_id = null
  for block in section.blocks
    if block.type == 'bundle_tier' and block.settings.preselected and preselected_block_id == null
      assign preselected_block = block
      assign preselected_block_id = block.id
    endif
  endfor
  if preselected_block_id == null
    for block in section.blocks
      if block.type == 'bundle_tier'
        assign preselected_block = block
        assign preselected_block_id = block.id
        break
      endif
    endfor
  endif

  assign main_gallery_image = null
  for block in section.blocks
    if block.type == 'gallery_image' and block.settings.image != blank and main_gallery_image == null
      assign main_gallery_image = block.settings.image
    endif
  endfor

  assign real_price = selected_variant.price
  assign real_compare = selected_variant.compare_at_price
  assign has_sale = false
  assign real_savings = 0
  if real_compare > real_price
    assign has_sale = true
    assign real_savings = real_compare | minus: real_price
  endif
-%}

<section class="rv-hero" id="rv-hero-{{ section.id }}">
  <div class="rv-hero__inner">

    <div class="rv-hero__gallery">
      <div class="rv-hero__main-media">
        {% if section.settings.badge_text != blank %}
          <span class="rv-hero__ribbon">{{ section.settings.badge_text }}</span>
        {% endif %}

        {% if main_gallery_image != blank %}
          {{
            main_gallery_image
            | image_url: width: 1400
            | image_tag:
              id: 'RvMainImage-' | append: section.id,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'rv-hero__img',
              sizes: '(min-width: 990px) 560px, 90vw',
              widths: '400, 600, 800, 1000, 1400',
              alt: main_gallery_image.alt | default: product.title
          }}
        {% elsif product.featured_image != blank %}
          {{
            product.featured_image
            | image_url: width: 1400
            | image_tag:
              id: 'RvMainImage-' | append: section.id,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'rv-hero__img',
              sizes: '(min-width: 990px) 560px, 90vw',
              widths: '400, 600, 800, 1000, 1400',
              alt: product.featured_image.alt | default: product.title
          }}
        {% else %}
          <div class="rv-placeholder" id="RvMainImage-{{ section.id }}" role="img" aria-label="Product image placeholder">
            <svg viewBox="0 0 24 24" class="rv-placeholder__icon" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M8 3h8l1 3v2a5 5 0 0 1-2 4v6a3 3 0 0 1-3 3h-0a3 3 0 0 1-3-3v-6a5 5 0 0 1-2-4V6l1-3Z" stroke-linejoin="round"/>
              <path d="M9 8h6" stroke-linecap="round"/>
            </svg>
            <span>Add a featured image to this product</span>
          </div>
        {% endif %}
      </div>

      {%- assign gallery_thumb_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
          {%- assign gallery_thumb_count = gallery_thumb_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {% if gallery_thumb_count > 1 %}
        <div class="rv-hero__thumbs" role="list" data-rv-thumbs>
          {%- assign rv_thumb_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
              {%- assign rv_thumb_index = rv_thumb_index | plus: 1 -%}
              <button
                type="button"
                class="rv-hero__thumb{% if rv_thumb_index == 1 %} is-active{% endif %}"
                data-full="{{ block.settings.image | image_url: width: 1400 }}"
                data-alt="{{ block.settings.image.alt | default: product.title | escape }}"
                aria-label="Show image {{ rv_thumb_index }}"
                {{ block.shopify_attributes }}
              >
                {{
                  block.settings.image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', widths: '100, 150, 200', alt: ''
                }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% endif %}
    </div>

    <div class="rv-hero__content">
      <div class="rv-hero__rating">
        <span class="rv-hero__avatars" aria-hidden="true">
          <span class="rv-hero__avatar rv-hero__avatar--1"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8.5" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></span>
          <span class="rv-hero__avatar rv-hero__avatar--2"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8.5" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></span>
          <span class="rv-hero__avatar rv-hero__avatar--3"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8.5" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></span>
        </span>
        <span class="rv-hero__rating-text">
          <span class="rv-hero__stars" aria-hidden="true">★★★★★</span>
          Rated {{ section.settings.rating_score }} · {{ section.settings.review_count_label }}
        </span>
      </div>

      {% if section.settings.category_tag != blank %}
        <p class="rv-hero__tag">{{ section.settings.category_tag }}</p>
      {% endif %}

      <h1 class="rv-hero__headline">{{ section.settings.headline }}</h1>
      {% if section.settings.subheadline != blank %}
        <p class="rv-hero__subheadline">{{ section.settings.subheadline }}</p>
      {% endif %}

      {%- assign has_benefit_blocks = false -%}
      <div class="rv-hero__benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit_icon' %}
            {%- assign has_benefit_blocks = true -%}
            <div class="rv-hero__benefit" {{ block.shopify_attributes }}>
              <span class="rv-hero__benefit-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'reduce-fall' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c4 5 6 8.5 6 11.5A6 6 0 0 1 6 14.5C6 11.5 8 8 12 3Z" stroke-linejoin="round"/><path d="M4 4l16 16" stroke-linecap="round"/></svg>
                  {% when 'scalp' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20c8-1 13-6 15-15-9 1-14 6-15 15Z" stroke-linejoin="round"/><path d="M6 18c3-4 6-7 12-11" stroke-linecap="round"/></svg>
                  {% when 'anti-dandruff' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3h6" stroke-linecap="round"/><path d="M10 3v6l-5.5 9.5A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-2.5L14 9V3" stroke-linejoin="round"/><path d="M8 15h8" stroke-linecap="round"/></svg>
                  {% when 'root-strength' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v6" stroke-linecap="round"/><path d="M12 9c-3 0-5 3-5.5 7.5" stroke-linecap="round"/><path d="M12 9c3 0 5 3 5.5 7.5" stroke-linecap="round"/><path d="M12 9c-1.3 2.3-1.3 5.2 0 9" stroke-linecap="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
                {% endcase %}
              </span>
              <span class="rv-hero__benefit-label">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.progress_percentage > 0 %}
        <div class="rv-hero__progress">
          <div class="rv-hero__progress-track">
            <div class="rv-hero__progress-fill" style="width: {{ section.settings.progress_percentage }}%;"></div>
          </div>
          <p class="rv-hero__progress-label">
            <strong>{{ section.settings.progress_percentage }}%</strong> {{ section.settings.progress_label }}
          </p>
        </div>
      {% endif %}

      <div class="rv-hero__price-row">
        <span class="rv-hero__price">{{ real_price | money }}</span>
        {% if has_sale %}
          <s class="rv-hero__compare">{{ real_compare | money }}</s>
          <span class="rv-hero__sale-badge">
            {{ section.settings.sale_badge_prefix }} — Save {{ real_savings | money_without_trailing_zeros }}
          </span>
        {% endif %}
      </div>

      <product-info
        id="ProductInfo-{{ section.id }}"
        class="rv-hero__product-info"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
      >
        <product-form
          id="ProductForm-{{ section.id }}"
          class="product-form main-product-form rv-hero__form"
          data-section="{{ section.id }}"
          data-options="{{ product.options | join: ',' }}"
        >
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>

          {%- form 'product',
            product,
            id: product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input
              type="hidden"
              name="id"
              value="{{ selected_variant.id }}"
              class="product-variant-id"
            >

            <rv-bundle-tiers class="rv-bundle" id="rv-add-to-cart">
              <div class="rv-bundle__tiers" role="radiogroup" aria-label="Choose your bundle size">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'bundle_tier' -%}
                    {%- liquid
                      assign is_checked = false
                      if block.id == preselected_block_id
                        assign is_checked = true
                      endif
                      assign tier_savings = block.settings.compare_at_price | minus: block.settings.price
                    -%}
                    <input
                      type="radio"
                      name="quantity"
                      id="RvTier-{{ block.id }}"
                      class="rv-bundle__radio visually-hidden"
                      value="{{ block.settings.quantity }}"
                      form="{{ product_form_id }}"
                      data-total-price="{{ block.settings.price | times: 100 | money }}"
                      data-free-shipping="{{ block.settings.free_shipping }}"
                      data-bonus-gift="{{ block.settings.bonus_gift_included }}"
                      data-bonus-gift-label="{{ block.settings.bonus_gift_label | escape }}"
                      {% if is_checked %}checked{% endif %}
                      {{ block.shopify_attributes }}
                    >
                    <label
                      for="RvTier-{{ block.id }}"
                      class="rv-bundle__tier{% if is_checked %} is-selected{% endif %}"
                    >
                      {% if block.settings.badge_label != blank %}
                        <span class="rv-bundle__tier-badge">{{ block.settings.badge_label }}</span>
                      {% endif %}

                      <span class="rv-bundle__tier-thumb" aria-hidden="true">
                        {% if block.settings.thumbnail_image != blank %}
                          {{ block.settings.thumbnail_image | image_url: width: 140 | image_tag: loading: 'lazy', widths: '70, 100, 140', alt: '' }}
                        {% else %}
                          <span class="rv-bundle__tier-thumb-placeholder">{{ block.settings.quantity }}×</span>
                        {% endif %}
                      </span>

                      <span class="rv-bundle__tier-main">
                        <span class="rv-bundle__tier-top">
                          <span class="rv-bundle__tier-check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </span>
                          <span class="rv-bundle__tier-qty">
                            {{ block.settings.quantity }}
                            <span class="rv-bundle__tier-qty-word">
                              {%- if block.settings.quantity == 1 -%}Pouch{%- else -%}Pouches{%- endif -%}
                            </span>
                          </span>
                        </span>
                        {% if tier_savings > 0 %}
                          <span class="rv-bundle__tier-save">You save {{ tier_savings | times: 100 | money_without_trailing_zeros }}</span>
                        {% endif %}
                        {% if block.settings.free_shipping %}
                          <span class="rv-bundle__tier-shipping">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h13v9H2z"/><path d="M15 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
                            Free Shipping
                          </span>
                        {% endif %}
                      </span>

                      <span class="rv-bundle__tier-prices">
                        <span class="rv-bundle__tier-price">{{ block.settings.price | times: 100 | money }}</span>
                        {% if block.settings.compare_at_price > block.settings.price %}
                          <s class="rv-bundle__tier-compare">{{ block.settings.compare_at_price | times: 100 | money }}</s>
                        {% endif %}
                      </span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="rv-bundle__gifts" data-rv-gifts>
                <p class="rv-bundle__gifts-title">Gifts Unlocked</p>
                <div class="rv-bundle__gifts-row">
                  <div class="rv-bundle__gift" data-gift="shipping">
                    <span class="rv-bundle__gift-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h13v9H2z"/><path d="M15 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
                    </span>
                    <span class="rv-bundle__gift-label">Free Shipping</span>
                  </div>
                  <div class="rv-bundle__gift" data-gift="bonus">
                    <span class="rv-bundle__gift-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 8h18v4H3z"/><path d="M12 8v13" stroke-linecap="round"/><path d="M12 8c-1.4-4-6-4-6-1.4C6 8 9 8 12 8Z" stroke-linejoin="round"/><path d="M12 8c1.4-4 6-4 6-1.4C18 8 15 8 12 8Z" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="rv-bundle__gift-label" data-gift-label>Bonus Gift</span>
                  </div>
                </div>
              </div>

              <div class="rv-bundle__sticky">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="atc-button product-form__submit button rv-bundle__atc"
                  {% if selected_variant.available == false %}
                    disabled
                    data-unavailable="true"
                  {% endif %}
                >
                  <span class="rv-bundle__atc-label">
                    {%- if selected_variant.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ section.settings.button_label }} —
                      <span data-rv-total-price>
                        {% if preselected_block %}{{ preselected_block.settings.price | times: 100 | money }}{% endif %}
                      </span>
                    {%- endif -%}
                  </span>
                  <div class="loading-overlay__spinner hidden">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      class="spinner"
                      viewBox="0 0 66 66"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>
                <p class="rv-bundle__guarantee">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3Z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ section.settings.guarantee_text }}
                </p>
              </div>
            </rv-bundle-tiers>
          {%- endform -%}
        </product-form>
      </product-info>

      {% if section.settings.footnote != blank %}
        <p class="rv-hero__footnote">{{ section.settings.footnote }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #rv-hero-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-cream-deep: #F3E4C8;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;
    --rv-brown-soft: #6B4F3B;
    --rv-border: #E7D6AF;
    --rv-green: #6E8F5A;

    background: linear-gradient(180deg, var(--rv-cream) 0%, var(--rv-cream-deep) 100%);
    padding: 28px 16px 40px;
  }

  #rv-hero-{{ section.id }} .rv-hero__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Gallery */
  #rv-hero-{{ section.id }} .rv-hero__gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #rv-hero-{{ section.id }} .rv-hero__main-media {
    position: relative;
  }

  #rv-hero-{{ section.id }} .rv-hero__ribbon {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    background: var(--rv-gold);
    color: #FFF9EF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
    box-shadow: 0 6px 14px rgba(62, 42, 30, 0.2);
  }

  #rv-hero-{{ section.id }} .rv-hero__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(62, 42, 30, 0.15);
  }

  #rv-hero-{{ section.id }} .rv-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    margin: 0 auto;
    border: 2px dashed var(--rv-border);
    border-radius: 24px;
    background: #FFFDF8;
    color: var(--rv-brown-soft);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #rv-hero-{{ section.id }} .rv-placeholder__icon {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

  #rv-hero-{{ section.id }} .rv-hero__thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 2px;
    -webkit-overflow-scrolling: touch;
  }

  #rv-hero-{{ section.id }} .rv-hero__thumb {
    flex: 0 0 auto;
    width: 68px;
    height: 68px;
    padding: 0;
    border-radius: 14px;
    border: 2px solid var(--rv-border);
    background: #FFFDF8;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  #rv-hero-{{ section.id }} .rv-hero__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #rv-hero-{{ section.id }} .rv-hero__thumb:hover {
    border-color: var(--rv-gold);
  }

  #rv-hero-{{ section.id }} .rv-hero__thumb.is-active {
    border-color: var(--rv-gold);
    box-shadow: 0 0 0 2px var(--rv-gold-dark) inset;
  }

  /* Content column */
  #rv-hero-{{ section.id }} .rv-hero__content {
    display: flex;
    flex-direction: column;
  }

  #rv-hero-{{ section.id }} .rv-hero__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  #rv-hero-{{ section.id }} .rv-hero__avatars {
    display: flex;
  }

  #rv-hero-{{ section.id }} .rv-hero__avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--rv-cream);
    margin-left: -8px;
    background: var(--rv-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF9EF;
  }

  #rv-hero-{{ section.id }} .rv-hero__avatar svg {
    width: 15px;
    height: 15px;
  }

  #rv-hero-{{ section.id }} .rv-hero__avatar:first-child {
    margin-left: 0;
  }

  #rv-hero-{{ section.id }} .rv-hero__avatar--1 { background: #C69B3B; }
  #rv-hero-{{ section.id }} .rv-hero__avatar--2 { background: #A87F2A; }
  #rv-hero-{{ section.id }} .rv-hero__avatar--3 { background: #6B4F3B; }

  #rv-hero-{{ section.id }} .rv-hero__rating-text {
    font-size: 13px;
    font-weight: 600;
    color: var(--rv-brown-soft);
  }

  #rv-hero-{{ section.id }} .rv-hero__stars {
    color: var(--rv-gold);
    letter-spacing: 1px;
    margin-right: 4px;
  }

  #rv-hero-{{ section.id }} .rv-hero__tag {
    display: inline-block;
    width: fit-content;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rv-gold-dark);
    background: var(--rv-cream-deep);
    border: 1px solid var(--rv-border);
    padding: 5px 12px;
    border-radius: 999px;
    margin: 0 0 12px;
  }

  #rv-hero-{{ section.id }} .rv-hero__headline {
    font-size: clamp(28px, 6vw, 46px);
    line-height: 1.12;
    font-weight: 800;
    color: var(--rv-brown);
    margin: 0 0 12px;
    letter-spacing: -0.5px;
  }

  #rv-hero-{{ section.id }} .rv-hero__subheadline {
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.6;
    color: var(--rv-brown-soft);
    max-width: 520px;
    margin: 0 0 20px;
  }

  #rv-hero-{{ section.id }} .rv-hero__benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 14px;
    margin-bottom: 20px;
  }

  #rv-hero-{{ section.id }} .rv-hero__benefit {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #rv-hero-{{ section.id }} .rv-hero__benefit-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--rv-cream-deep);
    color: var(--rv-gold-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #rv-hero-{{ section.id }} .rv-hero__benefit-icon svg {
    width: 15px;
    height: 15px;
  }

  #rv-hero-{{ section.id }} .rv-hero__benefit-label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--rv-brown);
    line-height: 1.3;
  }

  #rv-hero-{{ section.id }} .rv-hero__progress {
