{% comment %}
  reniva-hero-product.liquid
  Product-bound hero for the Reniva product template. Uses the real product's
  featured image and variant id so Add to Cart works with the theme's cart drawer.
  Add to cart area is a tiered bundle-pricing picker (Buy 1 / Buy 2 / Buy 3):
  selecting a tier sets the native "quantity" field submitted with the product
  form, so the correct quantity of the real product variant is added to cart.
{% endcomment %}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign preselected_block = null
  assign preselected_block_id = null
  for block in section.blocks
    if block.type == 'bundle_tier' and block.settings.preselected and preselected_block_id == null
      assign preselected_block = block
      assign preselected_block_id = block.id
    endif
  endfor
  if preselected_block_id == null
    for block in section.blocks
      if block.type == 'bundle_tier'
        assign preselected_block = block
        assign preselected_block_id = block.id
        break
      endif
    endfor
  endif
-%}

<section class="rv-hero" id="rv-hero-{{ section.id }}">
  <div class="rv-hero__inner">
    <div class="rv-hero__text">
      {% if section.settings.eyebrow != blank %}
        <p class="rv-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="rv-hero__headline">{{ section.settings.headline }}</h1>
      {% if section.settings.subheadline != blank %}
        <p class="rv-hero__subheadline">{{ section.settings.subheadline }}</p>
      {% endif %}

      <product-info
        id="ProductInfo-{{ section.id }}"
        class="rv-hero__product-info"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
      >
        <p class="rv-hero__product-name">{{ product.title }}</p>

        <product-form
          id="ProductForm-{{ section.id }}"
          class="product-form main-product-form rv-hero__form"
          data-section="{{ section.id }}"
          data-options="{{ product.options | join: ',' }}"
        >
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>

          {%- form 'product',
            product,
            id: product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input
              type="hidden"
              name="id"
              value="{{ selected_variant.id }}"
              class="product-variant-id"
            >

            <rv-bundle-tiers
              class="rv-bundle"
              id="rv-add-to-cart"
              data-delivery-days="{{ section.settings.delivery_days }}"
            >
              <div class="rv-bundle__tiers" role="radiogroup" aria-label="Choose your bundle size">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'bundle_tier' -%}
                    {%- liquid
                      assign is_checked = false
                      if block.id == preselected_block_id
                        assign is_checked = true
                      endif
                      assign tier_savings = block.settings.compare_at_price | minus: block.settings.price
                    -%}
                    <input
                      type="radio"
                      name="quantity"
                      id="RvTier-{{ block.id }}"
                      class="rv-bundle__radio visually-hidden"
                      value="{{ block.settings.quantity }}"
                      form="{{ product_form_id }}"
                      data-total-price="{{ block.settings.price | times: 100 | money }}"
                      {% if is_checked %}checked{% endif %}
                      {{ block.shopify_attributes }}
                    >
                    <label
                      for="RvTier-{{ block.id }}"
                      class="rv-bundle__tier{% if is_checked %} is-selected{% endif %}"
                    >
                      {% if block.settings.badge_label != blank %}
                        <span class="rv-bundle__tier-badge">{{ block.settings.badge_label }}</span>
                      {% endif %}
                      <span class="rv-bundle__tier-check" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </span>
                      <span class="rv-bundle__tier-qty">
                        {{ block.settings.quantity }}
                        <span class="rv-bundle__tier-qty-word">
                          {%- if block.settings.quantity == 1 -%}Bottle{%- else -%}Bottles{%- endif -%}
                        </span>
                      </span>
                      <span class="rv-bundle__tier-prices">
                        <span class="rv-bundle__tier-price">{{ block.settings.price | times: 100 | money }}</span>
                        {% if block.settings.compare_at_price > block.settings.price %}
                          <s class="rv-bundle__tier-compare">{{ block.settings.compare_at_price | times: 100 | money }}</s>
                        {% endif %}
                      </span>
                      {% if tier_savings > 0 %}
                        <span class="rv-bundle__tier-save">You save {{ tier_savings | times: 100 | money_without_trailing_zeros }}</span>
                      {% endif %}
                      {% if block.settings.free_shipping %}
                        <span class="rv-bundle__tier-shipping">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 7h13v9H2z"/><path d="M15 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
                          Free Shipping
                        </span>
                      {% endif %}
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <p class="rv-bundle__delivery">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18" stroke-linecap="round"/><path d="M8 2v4M16 2v4" stroke-linecap="round"/></svg>
                <span>
                  Order today for delivery by <strong data-rv-delivery-date>soon</strong>
                  {% if section.settings.ships_from != blank %}
                    · Ships from {{ section.settings.ships_from }}
                  {% endif %}
                </span>
              </p>

              <div class="rv-bundle__sticky">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="atc-button product-form__submit button rv-bundle__atc"
                  {% if selected_variant.available == false %}
                    disabled
                    data-unavailable="true"
                  {% endif %}
                >
                  <span class="rv-bundle__atc-label">
                    {%- if selected_variant.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ section.settings.button_label }} —
                      <span data-rv-total-price>
                        {% if preselected_block %}{{ preselected_block.settings.price | times: 100 | money }}{% endif %}
                      </span>
                    {%- endif -%}
                  </span>
                  <div class="loading-overlay__spinner hidden">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      class="spinner"
                      viewBox="0 0 66 66"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>
                <p class="rv-bundle__guarantee">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3Z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ section.settings.guarantee_text }}
                </p>
              </div>
            </rv-bundle-tiers>
          {%- endform -%}
        </product-form>

        {% if section.settings.show_size_badge %}
          <span class="rv-hero__badge">{{ section.settings.size_badge_text }}</span>
        {% endif %}
      </product-info>
    </div>

    <div class="rv-hero__media">
      {% if product.featured_image != blank %}
        {{
          product.featured_image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            class: 'rv-hero__img',
            sizes: '(min-width: 990px) 560px, 90vw',
            widths: '400, 600, 800, 1000, 1400',
            alt: product.featured_image.alt | default: product.title
        }}
      {% else %}
        <div class="rv-placeholder" role="img" aria-label="Product image placeholder">
          <svg viewBox="0 0 24 24" class="rv-placeholder__icon" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3h8l1 3v2a5 5 0 0 1-2 4v6a3 3 0 0 1-3 3h-0a3 3 0 0 1-3-3v-6a5 5 0 0 1-2-4V6l1-3Z" stroke-linejoin="round"/>
            <path d="M9 8h6" stroke-linecap="round"/>
          </svg>
          <span>Add a featured image to this product</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #rv-hero-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-cream-deep: #F3E4C8;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;
    --rv-brown-soft: #6B4F3B;
    --rv-border: #E7D6AF;

    background: linear-gradient(180deg, var(--rv-cream) 0%, var(--rv-cream-deep) 100%);
    padding: 48px 20px;
  }

  #rv-hero-{{ section.id }} .rv-hero__inner {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  #rv-hero-{{ section.id }} .rv-hero__text {
    order: 1;
    text-align: center;
  }

  #rv-hero-{{ section.id }} .rv-hero__media {
    order: 2;
  }

  #rv-hero-{{ section.id }} .rv-hero__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rv-gold-dark);
    margin: 0 0 14px;
  }

  #rv-hero-{{ section.id }} .rv-hero__headline {
    font-size: clamp(30px, 6vw, 52px);
    line-height: 1.12;
    font-weight: 800;
    color: var(--rv-brown);
    margin: 0 0 12px;
    letter-spacing: -0.5px;
  }

  #rv-hero-{{ section.id }} .rv-hero__subheadline {
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.6;
    color: var(--rv-brown-soft);
    max-width: 520px;
    margin: 0 auto 24px;
  }

  #rv-hero-{{ section.id }} .rv-hero__product-info {
    display: block;
    max-width: 460px;
    margin: 0 auto;
  }

  #rv-hero-{{ section.id }} .rv-hero__product-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rv-brown-soft);
    margin: 0 0 14px;
    text-align: left;
  }

  /* Bundle tiers */
  #rv-hero-{{ section.id }} .rv-bundle {
    display: block;
    text-align: left;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tiers {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 18px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 14px;
    row-gap: 6px;
    background: #FFFDF8;
    border: 2px solid var(--rv-border);
    border-radius: 16px;
    padding: 16px 18px;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier:hover {
    border-color: var(--rv-gold);
  }

  #rv-hero-{{ section.id }} .rv-bundle__radio:focus-visible + .rv-bundle__tier {
    outline: 2px solid var(--rv-gold-dark);
    outline-offset: 2px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier.is-selected {
    border-color: var(--rv-gold);
    background: #FFF9EC;
    box-shadow: 0 6px 18px rgba(198, 155, 59, 0.22);
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-check {
    grid-row: 1 / 3;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid var(--rv-border);
    color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-check svg {
    width: 12px;
    height: 12px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier.is-selected .rv-bundle__tier-check {
    background: var(--rv-gold);
    border-color: var(--rv-gold);
    color: #FFF9EF;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-qty {
    font-size: 20px;
    font-weight: 800;
    color: var(--rv-brown);
    line-height: 1.2;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-qty-word {
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rv-brown-soft);
    margin-left: 4px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-prices {
    grid-column: 3;
    grid-row: 1;
    text-align: right;
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-price {
    font-size: 19px;
    font-weight: 800;
    color: var(--rv-brown);
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-compare {
    font-size: 14px;
    color: var(--rv-brown-soft);
    opacity: 0.8;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-save {
    grid-column: 2 / 4;
    grid-row: 2;
    font-size: 12.5px;
    font-weight: 700;
    color: #6E8F5A;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-badge {
    position: absolute;
    top: -11px;
    left: 16px;
    background: var(--rv-gold);
    color: #FFF9EF;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-shipping {
    grid-column: 2 / 4;
    grid-row: 3;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--rv-gold-dark);
    background: var(--rv-cream-deep);
    padding: 3px 9px;
    border-radius: 999px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__tier-shipping svg {
    width: 13px;
    height: 13px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__delivery {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    color: var(--rv-brown-soft);
    background: var(--rv-cream-deep);
    border: 1px solid var(--rv-border);
    border-radius: 12px;
    padding: 10px 14px;
    margin: 0 0 18px;
    line-height: 1.5;
  }

  #rv-hero-{{ section.id }} .rv-bundle__delivery svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--rv-gold-dark);
  }

  #rv-hero-{{ section.id }} .rv-bundle__delivery strong {
    color: var(--rv-brown);
  }

  #rv-hero-{{ section.id }} .rv-bundle__sticky {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    padding: 0 24px;
    border: none;
    border-radius: 999px;
    background: var(--rv-gold);
    color: #FFF9EF;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
    min-height: 56px;
    width: 100%;
  }

  #rv-hero-{{ section.id }} .rv-bundle__atc-label {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  #rv-hero-{{ section.id }} .rv-bundle__atc:hover {
    background: var(--rv-gold-dark);
    transform: translateY(-1px);
  }

  #rv-hero-{{ section.id }} .rv-bundle__atc[disabled] {
    background: var(--rv-border);
    color: var(--rv-brown-soft);
    cursor: not-allowed;
    transform: none;
  }

  #rv-hero-{{ section.id }} .rv-bundle__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--rv-brown-soft);
    margin: 0;
  }

  #rv-hero-{{ section.id }} .rv-bundle__guarantee svg {
    width: 15px;
    height: 15px;
    color: var(--rv-gold-dark);
  }

  #rv-hero-{{ section.id }} .rv-hero__badge {
    display: inline-block;
    margin-top: 18px;
    font-size: 13px;
    font-weight: 600;
    color: var(--rv-brown-soft);
    background: #FFF;
    border: 1px solid var(--rv-border);
    padding: 6px 14px;
    border-radius: 999px;
  }

  #rv-hero-{{ section.id }} .rv-hero__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(62, 42, 30, 0.15);
  }

  #rv-hero-{{ section.id }} .rv-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    margin: 0 auto;
    border: 2px dashed var(--rv-border);
    border-radius: 24px;
    background: #FFFDF8;
    color: var(--rv-brown-soft);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #rv-hero-{{ section.id }} .rv-placeholder__icon {
    width: 48px;
    height: 48px;
    opacity: 0.6;
  }

  @media screen and (min-width: 990px) {
    #rv-hero-{{ section.id }} {
      padding: 80px 40px;
    }
    #rv-hero-{{ section.id }} .rv-hero__inner {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      text-align: left;
    }
    #rv-hero-{{ section.id }} .rv-hero__text {
      text-align: left;
      order: {% if section.settings.image_position == 'left' %}2{% else %}1{% endif %};
    }
    #rv-hero-{{ section.id }} .rv-hero__media {
      order: {% if section.settings.image_position == 'left' %}1{% else %}2{% endif %};
    }
    #rv-hero-{{ section.id }} .rv-hero__subheadline,
    #rv-hero-{{ section.id }} .rv-hero__product-info {
      margin-left: 0;
      margin-right: 0;
    }
  }
{% endstyle %}

<script>
  (function () {
    function initRvBundle(root) {
      if (!root || root.dataset.rvInit === 'true') return;
      root.dataset.rvInit = 'true';

      var radios = root.querySelectorAll('.rv-bundle__radio');
      var totalPriceEls = root.querySelectorAll('[data-rv-total-price]');

      function selectTier(radio) {
        radios.forEach(function (r) {
          var label = root.querySelector('label[for="' + r.id + '"]');
          if (label) label.classList.toggle('is-selected', r === radio);
        });
        var price = radio.getAttribute('data-total-price');
        if (price) {
          totalPriceEls.forEach(function (el) {
            el.textContent = price;
          });
        }
      }

      radios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          if (radio.checked) selectTier(radio);
        });
      });

      var checked = root.querySelector('.rv-bundle__radio:checked');
      if (checked) selectTier(checked);

      var dateEl = root.querySelector('[data-rv-delivery-date]');
      if (dateEl) {
        var days = parseInt(root.getAttribute('data-delivery-days'), 10);
        if (isNaN(days) || days < 0) days = 5;
        var deliveryDate = new Date();
        deliveryDate.setDate(deliveryDate.getDate() + days);
        try {
          dateEl.textContent = new Intl.DateTimeFormat('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric'
          }).format(deliveryDate);
        } catch (e) {
          dateEl.textContent = deliveryDate.toDateString();
        }
      }
    }

    function initAll() {
      document.querySelectorAll('rv-bundle-tiers').forEach(initRvBundle);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var bundle = event.target.querySelector('rv-bundle-tiers');
      if (bundle) {
        bundle.dataset.rvInit = 'false';
        initRvBundle(bundle);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Reniva Hero (Product)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "RENIVA · ANTI-HAIR FALL SHAMPOO"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Stop the Fall. Start the Regrowth."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "A botanical-powered formula that strengthens roots, calms an irritated scalp, and helps you hold onto the hair you have — one wash at a time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button label",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_size_badge",
      "label": "Show size badge",
      "default": true
    },
    {
      "type": "text",
      "id": "size_badge_text",
      "label": "Size badge text",
      "default": "300ml Pouch"
    },
    {
      "type": "header",
      "content": "Delivery & guarantee"
    },
    {
      "type": "number",
      "id": "delivery_days",
      "label": "Estimated delivery (days from today)",
      "default": 5
    },
    {
      "type": "text",
      "id": "ships_from",
      "label": "Ships from location",
      "default": "Los Angeles, CA"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee badge text",
      "default": "30-Day Guarantee"
    }
  ],
  "blocks": [
    {
      "type": "bundle_tier",
      "name": "Bundle tier",
      "settings": [
        {
