{% comment %} reniva-promo-banner.liquid {% endcomment %}
<section class="rv-promo" id="rv-promo-{{ section.id }}">
  <div class="rv-promo__inner">
    <p class="rv-promo__text">{{ section.settings.text }}</p>
    {% if section.settings.subtext != blank %}
      <p class="rv-promo__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        {% if section.settings.button_link != blank %}
          href="{{ section.settings.button_link }}"
        {% else %}
          href="#"
        {% endif %}
        class="rv-promo__btn"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% style %}
  #rv-promo-{{ section.id }} {
    background: linear-gradient(135deg, #3E2A1E 0%, #6B4A2E 100%);
    padding: 32px 20px;
    text-align: center;
  }

  #rv-promo-{{ section.id }} .rv-promo__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  #rv-promo-{{ section.id }} .rv-promo__text {
    font-size: clamp(20px, 4vw, 28px);
    font-weight: 800;
    color: #F3E4C8;
    margin: 0 0 6px;
    letter-spacing: -0.3px;
  }

  #rv-promo-{{ section.id }} .rv-promo__subtext {
    font-size: 14px;
    color: #E7D6AF;
    margin: 0 0 18px;
  }

  #rv-promo-{{ section.id }} .rv-promo__btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 13px 30px;
    border-radius: 999px;
    background: #C69B3B;
    color: #3E2A1E;
    margin-top: 6px;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-promo-{{ section.id }} .rv-promo__btn:hover {
    background: #E4C874;
    transform: translateY(-1px);
  }

  @media screen and (min-width: 750px) {
    #rv-promo-{{ section.id }} {
      padding: 40px 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Promo text",
      "default": "Buy 1, Get 1 Free — Limited Time"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "While supplies last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Claim Offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Reniva Promo Banner"
    }
  ]
}
{% endschema %}
