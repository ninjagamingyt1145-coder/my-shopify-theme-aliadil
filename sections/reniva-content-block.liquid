{% comment %}
  reniva-content-block.liquid
  Reusable heading + body text block matching the Reniva design system.
  Used for simple copy sections (intro paragraphs, "Our Story", "Our Mission", etc.)
  where no image, icon grid, or CTA is needed.
{% endcomment %}
<section class="rv-content" id="rv-content-{{ section.id }}">
  <div class="rv-content__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="rv-content__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="rv-content__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="rv-content__body rte">{{ section.settings.body }}</div>
    {% endif %}
  </div>
</section>

{% style %}
  #rv-content-{{ section.id }} {
    background: {% case section.settings.background %}
      {% when 'cream' %}#FBF3E4
      {% when 'cream-deep' %}#F3E4C8
      {% else %}#FFF9EF
    {% endcase %};
    padding: 48px 20px;
  }

  #rv-content-{{ section.id }} .rv-content__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  #rv-content-{{ section.id }} .rv-content__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #A87F2A;
    margin: 0 0 14px;
  }

  #rv-content-{{ section.id }} .rv-content__heading {
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 800;
    color: #3E2A1E;
    margin: 0 0 18px;
    letter-spacing: -0.4px;
  }

  #rv-content-{{ section.id }} .rv-content__body {
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.7;
    color: #6B4F3B;
  }

  #rv-content-{{ section.id }} .rv-content__body p {
    margin: 0 0 14px;
  }

  #rv-content-{{ section.id }} .rv-content__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    #rv-content-{{ section.id }} {
      padding: 72px 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Content Block",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Add your text here.</p>"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "cream-deep", "label": "Cream (deep)" }
      ],
      "default": "white"
    }
  ],
  "presets": [
    {
      "name": "Reniva Content Block"
    }
  ]
}
{% endschema %}
