{% comment %} reniva-benefits-accordion.liquid — light interactive accordion grid {% endcomment %}
<section class="rv-ba" id="rv-ba-{{ section.id }}">
  <div class="rv-ba__inner">
    <h2 class="rv-ba__headline">{{ section.settings.headline }}</h2>
    {% if section.settings.subheadline != blank %}
      <p class="rv-ba__subheadline">{{ section.settings.subheadline }}</p>
    {% endif %}

    <div class="rv-ba__grid">
      {% for block in section.blocks %}
        <div class="rv-ba__card" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="rv-ba__card-trigger"
            aria-expanded="false"
            aria-controls="RvBaPanel-{{ block.id }}"
            id="RvBaTrigger-{{ block.id }}"
          >
            <span class="rv-ba__card-thumb">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', class: 'rv-ba__card-img', widths: '100, 150, 200'
                }}
              {% else %}
                <span class="rv-ba__card-placeholder" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
                </span>
              {% endif %}
            </span>
            <span class="rv-ba__card-copy">
              <span class="rv-ba__card-title">{{ block.settings.title }}</span>
              <span class="rv-ba__card-line">{{ block.settings.tagline }}</span>
            </span>
            <span class="rv-ba__card-toggle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            </span>
          </button>
          <div class="rv-ba__card-panel" id="RvBaPanel-{{ block.id }}" role="region" aria-labelledby="RvBaTrigger-{{ block.id }}">
            <div class="rv-ba__card-panel-inner">
              <p>{{ block.settings.expanded_text }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.footnote != blank %}
      <p class="rv-ba__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% style %}
  #rv-ba-{{ section.id }} {
    background: #FFF9EF;
    padding: 56px 20px;
  }

  #rv-ba-{{ section.id }} .rv-ba__inner {
    max-width: 980px;
    margin: 0 auto;
    text-align: center;
  }

  #rv-ba-{{ section.id }} .rv-ba__headline {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 800;
    color: #3E2A1E;
    margin: 0 0 12px;
    letter-spacing: -0.4px;
  }

  #rv-ba-{{ section.id }} .rv-ba__subheadline {
    font-size: 16px;
    color: #6B4F3B;
    max-width: 560px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  #rv-ba-{{ section.id }} .rv-ba__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    text-align: left;
  }

  #rv-ba-{{ section.id }} .rv-ba__card {
    background: #FBF3E4;
    border: 1px solid #EEDFC0;
    border-radius: 18px;
    overflow: hidden;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    overflow: hidden;
    background: #FFFDF8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-placeholder {
    color: #C69B3B;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-placeholder svg {
    width: 26px;
    height: 26px;
    opacity: 0.6;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-copy {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-title {
    font-size: 16px;
    font-weight: 800;
    color: #3E2A1E;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-line {
    font-size: 13.5px;
    color: #6B4F3B;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-toggle {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #C69B3B;
    color: #FFF9EF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background 0.2s ease;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-toggle svg {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-trigger[aria-expanded="true"] .rv-ba__card-toggle {
    background: #A87F2A;
    transform: rotate(135deg);
  }

  #rv-ba-{{ section.id }} .rv-ba__card-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-panel-inner p {
    margin: 0;
    padding: 0 18px 20px 88px;
    font-size: 14px;
    line-height: 1.6;
    color: #6B4F3B;
  }

  #rv-ba-{{ section.id }} .rv-ba__card-panel.is-open {
    grid-template-rows: 1fr;
  }

  #rv-ba-{{ section.id }} .rv-ba__footnote {
    margin: 32px 0 0;
    font-size: 11.5px;
    color: #9C8367;
  }

  @media screen and (min-width: 750px) {
    #rv-ba-{{ section.id }} {
      padding: 80px 40px;
    }
    #rv-ba-{{ section.id }} .rv-ba__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    #rv-ba-{{ section.id }} .rv-ba__card-panel-inner p {
      padding-left: 88px;
    }
  }
{% endstyle %}

<script>
  (function () {
    function initRvAccordion(section) {
      if (!section || section.dataset.rvInit === 'true') return;
      section.dataset.rvInit = 'true';

      section.querySelectorAll('.rv-ba__card-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
          var expanded = trigger.getAttribute('aria-expanded') === 'true';
          var panel = document.getElementById(trigger.getAttribute('aria-controls'));
          trigger.setAttribute('aria-expanded', String(!expanded));
          if (panel) panel.classList.toggle('is-open', !expanded);
        });
      });
    }

    function initAll() {
      document.querySelectorAll('.rv-ba').forEach(initRvAccordion);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var section = event.target.querySelector('.rv-ba');
      if (section) {
        section.dataset.rvInit = 'false';
        initRvAccordion(section);
      }
    });
  })();
</script>

