<style>
  .xtrans-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 72px 24px 80px;
  }

  .xtrans-inner {
    max-width: 1300px;
    margin: 0 auto;
  }

  .xtrans-header {
    text-align: center;
    margin-bottom: 52px;
  }

  .xtrans-heading {
    font-size: 44px;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 8px;
    line-height: 1.15;
  }

  .xtrans-heading-underline {
    display: block;
    width: 60px;
    height: 3px;
    background-color: #8b1a1a;
    margin: 10px auto 16px;
    border-radius: 2px;
  }

  .xtrans-subheading {
    font-size: 16px;
    color: #aaaaaa;
    margin: 0;
  }

  .xtrans-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .xtrans-col {
    padding: 0 16px 48px;
  }

  .xtrans-col:first-child {
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .xtrans-step-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .xtrans-step-number {
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    line-height: 1;
  }

  .xtrans-step-badge {
    background-color: #8b1a1a;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 7px 18px;
    border-radius: 999px;
    line-height: 1;
  }

  .xtrans-card {
    background: #f5f5f5;
    border-radius: 20px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .xtrans-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .xtrans-card-image-wrap {
    width: 100%;
    padding: 14px 14px 0;
    box-sizing: border-box;
  }

  .xtrans-card-image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  .xtrans-card-body {
    padding: 24px 24px 28px;
  }

  .xtrans-card-title {
    font-size: 20px;
    font-weight: 900;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .xtrans-card-title-underline {
    display: block;
    width: 32px;
    height: 3px;
    background-color: #8b1a1a;
    margin-bottom: 14px;
    border-radius: 2px;
  }

  .xtrans-card-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #444444;
    margin: 0 0 18px;
  }

  .xtrans-card-bullets {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .xtrans-card-bullets li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .xtrans-bullet-check {
    color: #8b1a1a;
    font-size: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .xtrans-grid {
      grid-template-columns: 1fr;
    }

    .xtrans-col:first-child {
      border-right: none;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .xtrans-heading {
      font-size: 28px;
    }

    .xtrans-subheading {
      font-size: 14px;
    }

    .xtrans-card-title {
      font-size: 17px;
    }
  }

  @media (max-width: 560px) {
    .xtrans-wrapper {
      padding: 48px 0 56px;
    }

    .xtrans-header {
      padding: 0 16px;
      margin-bottom: 32px;
    }

    .xtrans-heading {
      font-size: 22px;
    }

    .xtrans-col {
      padding: 0 16px 36px;
    }

    .xtrans-card-title {
      font-size: 15px;
    }

    .xtrans-card-body {
      padding: 18px 18px 22px;
    }

    .xtrans-card-desc {
      font-size: 13px;
    }

    .xtrans-card-bullets li {
      font-size: 12px;
    }
  }
</style>

<div class="xtrans-wrapper">
  <div class="xtrans-inner">

    <div class="xtrans-header">
      <h2 class="xtrans-heading">{{ section.settings.heading }}</h2>
      <span class="xtrans-heading-underline"></span>
      <p class="xtrans-subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="xtrans-grid">
      {% for block in section.blocks %}
        {% assign col_mod = forloop.index | modulo: 2 %}

        {% if col_mod == 1 %}
          <div class="xtrans-col">
        {% endif %}

            <div class="xtrans-step-row">
              <span class="xtrans-step-number">{{ forloop.index }}</span>
              <span class="xtrans-step-badge">{{ block.settings.badge }}</span>
            </div>

            <div class="xtrans-card" data-xtrans-card {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="xtrans-card-image-wrap">
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}
              <div class="xtrans-card-body">
                <p class="xtrans-card-title">{{ block.settings.title }}</p>
                <span class="xtrans-card-title-underline"></span>
                <p class="xtrans-card-desc">{{ block.settings.description }}</p>
                {% if block.settings.bullet_1 != blank or block.settings.bullet_2 != blank or block.settings.bullet_3 != blank %}
                  <ul class="xtrans-card-bullets">
                    {% if block.settings.bullet_1 != blank %}
                      <li><span class="xtrans-bullet-check">✓</span> {{ block.settings.bullet_1 }}</li>
                    {% endif %}
                    {% if block.settings.bullet_2 != blank %}
                      <li><span class="xtrans-bullet-check">✓</span> {{ block.settings.bullet_2 }}</li>
                    {% endif %}
                    {% if block.settings.bullet_3 != blank %}
                      <li><span class="xtrans-bullet-check">✓</span> {{ block.settings.bullet_3 }}</li>
                    {% endif %}
                  </ul>
                {% endif %}
              </div>
            </div>

        {% if col_mod == 0 or forloop.last %}
          </div>
        {% endif %}

      {% endfor %}
    </div>

  </div>
</div>

<script>
  (function () {
    function initXtrans() {
      var cards = document.querySelectorAll('[data-xtrans-card]');
      if (!cards.length) return;

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var card = entry.target;
              var index = Array.from(cards).indexOf(card);
              setTimeout(function () {
                card.classList.add('is-visible');
              }, (index % 2) * 150);
              observer.unobserve(card);
            }
          });
        }, { threshold: 0.1 });

        cards.forEach(function (card) {
          observer.observe(card);
        });
      } else {
        cards.forEach(function (card) {
          card.classList.add('is-visible');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initXtrans);
    } else {
      initXtrans();
    }

    document.addEventListener('shopify:section:load', initXtrans);
  })();
</script>

