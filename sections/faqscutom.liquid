          "settings": {
            "question": "¿Y si no me funciona?",
            "answer": "<p>Ofrecemos garantia de satisfaccion. Si no ves resultados, contactanos para una solucion.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
