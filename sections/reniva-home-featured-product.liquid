{% comment %}
  reniva-home-featured-product.liquid
  Simple product spotlight for the homepage. Driven by a product picker so
  it keeps working as more products are added — just point it at whichever
  product should be featured.
{% endcomment %}
{%- assign featured_product = section.settings.product -%}
{%- assign featured_image = section.settings.image | default: featured_product.featured_image -%}

<section class="rv-hfeat" id="rv-hfeat-{{ section.id }}">
  <div class="rv-hfeat__inner">
    <div class="rv-hfeat__media">
      {% if featured_image != blank %}
        {{
          featured_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'rv-hfeat__img',
            sizes: '(min-width: 990px) 480px, 90vw',
            widths: '400, 600, 800, 1000, 1200',
            alt: featured_image.alt | default: featured_product.title
        }}
      {% else %}
        <div class="rv-hfeat__placeholder" role="img" aria-label="Product image placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 3h8l1 3v2a5 5 0 0 1-2 4v6a3 3 0 0 1-3 3h-0a3 3 0 0 1-3-3v-6a5 5 0 0 1-2-4V6l1-3Z" stroke-linejoin="round"/>
            <path d="M9 8h6" stroke-linecap="round"/>
          </svg>
          <span>{% if featured_product == blank %}Select a product to feature{% else %}Add an image to this product{% endif %}</span>
        </div>
      {% endif %}
    </div>

    <div class="rv-hfeat__content">
      {% if section.settings.heading != blank %}
        <h2 class="rv-hfeat__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if featured_product != blank %}
        <p class="rv-hfeat__name">{{ featured_product.title }}</p>
      {% endif %}

      {% if section.settings.blurb != blank %}
        <p class="rv-hfeat__blurb">{{ section.settings.blurb }}</p>
      {% endif %}

      {% if featured_product != blank %}
        {%- assign fp_variant = featured_product.selected_or_first_available_variant -%}
        <div class="rv-hfeat__price-row">
          <span class="rv-hfeat__price">{{ fp_variant.price | money }}</span>
          {% if fp_variant.compare_at_price > fp_variant.price %}
            <s class="rv-hfeat__compare">{{ fp_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>

        <a href="{{ featured_product.url }}" class="rv-hfeat__btn">
          {{ section.settings.button_label | default: 'Shop Now' }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #rv-hfeat-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-cream-deep: #F3E4C8;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;
    --rv-brown-soft: #6B4F3B;
    --rv-border: #E7D6AF;

    background: var(--rv-cream);
    padding: 48px 20px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__inner {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 22px;
    box-shadow: 0 18px 36px rgba(62, 42, 30, 0.14);
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    aspect-ratio: 4 / 5;
    border: 2px dashed var(--rv-border);
    border-radius: 22px;
    background: #FFFDF8;
    color: var(--rv-brown-soft);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__placeholder svg {
    width: 44px;
    height: 44px;
    opacity: 0.6;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__content {
    text-align: center;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__heading {
    font-size: clamp(26px, 5vw, 36px);
    font-weight: 800;
    color: var(--rv-brown);
    margin: 0 0 10px;
    letter-spacing: -0.4px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__name {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rv-gold-dark);
    margin: 0 0 14px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__blurb {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--rv-brown-soft);
    max-width: 440px;
    margin: 0 auto 20px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__price {
    font-size: 24px;
    font-weight: 800;
    color: var(--rv-brown);
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__compare {
    font-size: 16px;
    color: var(--rv-brown-soft);
    opacity: 0.75;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: 15px 32px;
    border-radius: 999px;
    background: var(--rv-gold);
    color: #FFF9EF;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-hfeat-{{ section.id }} .rv-hfeat__btn:hover {
    background: var(--rv-gold-dark);
    transform: translateY(-1px);
  }

  @media screen and (min-width: 990px) {
    #rv-hfeat-{{ section.id }} {
      padding: 80px 40px;
    }
    #rv-hfeat-{{ section.id }} .rv-hfeat__inner {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
    #rv-hfeat-{{ section.id }} .rv-hfeat__content {
      text-align: left;
    }
    #rv-hfeat-{{ section.id }} .rv-hfeat__price-row {
      justify-content: flex-start;
    }
    #rv-hfeat-{{ section.id }} .rv-hfeat__blurb {
      margin-left: 0;
      margin-right: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Featured Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Reniva"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product to feature"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Optional. Defaults to the selected product's featured image."
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Our botanical anti-hair fall shampoo, formulated with five plant extracts to strengthen roots and calm your scalp."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Reniva Featured Product"
    }
  ]
}
{% endschema %}
