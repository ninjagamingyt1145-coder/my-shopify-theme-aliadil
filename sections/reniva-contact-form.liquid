{% comment %}
  reniva-contact-form.liquid
  Reniva-styled wrapper around Shopify's native contact form ({% form 'contact' %}),
  so submissions are handled natively (no app required) and arrive as customer
  contact notifications in Shopify admin.
{% endcomment %}
<section class="rv-contact" id="rv-contact-{{ section.id }}">
  <div class="rv-contact__inner">
    <div class="rv-contact__card">
      {% if section.settings.form_title != blank %}
        <h2 class="rv-contact__title">{{ section.settings.form_title }}</h2>
      {% endif %}

      <contact-form class="rv-contact__form-wrap">
        {% form 'contact', id: 'ContactForm' %}
          {%- if form.posted_successfully? -%}
            <div class="rv-contact__message rv-contact__message--success" role="alert" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>Thanks for reaching out. We'll get back to you as soon as possible.</span>
            </div>
          {%- elsif form.errors -%}
            <div class="rv-contact__message rv-contact__message--error" role="alert" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01" stroke-linecap="round"/></svg>
              <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
            </div>
          {%- endif -%}

          <div class="rv-contact__row">
            <div class="rv-contact__field">
              <label for="RvContactName-{{ section.id }}">Name</label>
              <input
                type="text"
                id="RvContactName-{{ section.id }}"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Your name"
              >
            </div>
            <div class="rv-contact__field">
              <label for="RvContactEmail-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="RvContactEmail-{{ section.id }}"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="you@example.com"
                {%- if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif -%}
              >
            </div>
          </div>

          <div class="rv-contact__field">
            <label for="RvContactOrder-{{ section.id }}">Order number <span class="rv-contact__optional">(optional)</span></label>
            <input
              type="text"
              id="RvContactOrder-{{ section.id }}"
              name="contact[Order number]"
              placeholder="e.g. #1234"
            >
          </div>

          <div class="rv-contact__field">
            <label for="RvContactMessage-{{ section.id }}">Message</label>
            <textarea
              id="RvContactMessage-{{ section.id }}"
              name="contact[body]"
              rows="6"
              placeholder="How can we help?"
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="rv-contact__submit">Send Message</button>
        {% endform %}
      </contact-form>

      {% if section.settings.support_email != blank or section.settings.support_hours != blank %}
        <div class="rv-contact__support">
          {% if section.settings.support_email != blank %}
            <p><strong>Email us:</strong> <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a></p>
          {% endif %}
          {% if section.settings.support_hours != blank %}
            <p><strong>Support hours:</strong> {{ section.settings.support_hours }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.faq_teaser_title != blank %}
      <div class="rv-contact__faq-teaser">
        <p class="rv-contact__faq-teaser-title">{{ section.settings.faq_teaser_title }}</p>
        {% if section.settings.faq_teaser_text != blank %}
          <p class="rv-contact__faq-teaser-text">{{ section.settings.faq_teaser_text }}</p>
        {% endif %}
        {% if section.settings.faq_link != blank %}
          <a href="{{ section.settings.faq_link }}" class="rv-contact__faq-teaser-link">
            {{ section.settings.faq_link_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #rv-contact-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-cream-deep: #F3E4C8;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;
    --rv-brown-soft: #6B4F3B;
    --rv-border: #E7D6AF;

    background: #FFF9EF;
    padding: 48px 20px;
  }

  #rv-contact-{{ section.id }} .rv-contact__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  #rv-contact-{{ section.id }} .rv-contact__card {
    background: #FFFDF8;
    border: 1px solid var(--rv-border);
    border-radius: 20px;
    padding: 28px 22px;
  }

  #rv-contact-{{ section.id }} .rv-contact__title {
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 800;
    color: var(--rv-brown);
    margin: 0 0 20px;
    letter-spacing: -0.3px;
  }

  #rv-contact-{{ section.id }} .rv-contact__message {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 20px;
  }

  #rv-contact-{{ section.id }} .rv-contact__message svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  #rv-contact-{{ section.id }} .rv-contact__message--success {
    background: #EFF6E9;
    color: #4A6B39;
  }

  #rv-contact-{{ section.id }} .rv-contact__message--error {
    background: #FBEAE7;
    color: #A13A2C;
  }

  #rv-contact-{{ section.id }} .rv-contact__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  #rv-contact-{{ section.id }} .rv-contact__field {
    margin-bottom: 16px;
  }

  #rv-contact-{{ section.id }} .rv-contact__row .rv-contact__field {
    margin-bottom: 0;
  }

  #rv-contact-{{ section.id }} .rv-contact__field label {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rv-brown-soft);
    margin-bottom: 6px;
  }

  #rv-contact-{{ section.id }} .rv-contact__field label span[aria-hidden] {
    color: var(--rv-gold-dark);
  }

  #rv-contact-{{ section.id }} .rv-contact__optional {
    text-transform: none;
    font-weight: 500;
    letter-spacing: 0;
    color: #9C8367;
  }

  #rv-contact-{{ section.id }} .rv-contact__field input,
  #rv-contact-{{ section.id }} .rv-contact__field textarea {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    font-size: 15px;
    color: var(--rv-brown);
    background: #FFFFFF;
    border: 1px solid var(--rv-border);
    border-radius: 12px;
    padding: 12px 14px;
  }

  #rv-contact-{{ section.id }} .rv-contact__field input:focus,
  #rv-contact-{{ section.id }} .rv-contact__field textarea:focus {
    outline: none;
    border-color: var(--rv-gold);
    box-shadow: 0 0 0 3px rgba(198, 155, 59, 0.18);
  }

  #rv-contact-{{ section.id }} .rv-contact__field textarea {
    resize: vertical;
    min-height: 120px;
  }

  #rv-contact-{{ section.id }} .rv-contact__submit {
    width: 100%;
    border: none;
    border-radius: 999px;
    background: var(--rv-gold);
    color: #FFF9EF;
    font-weight: 700;
    font-size: 16px;
    padding: 15px 24px;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-contact-{{ section.id }} .rv-contact__submit:hover {
    background: var(--rv-gold-dark);
    transform: translateY(-1px);
  }

  #rv-contact-{{ section.id }} .rv-contact__support {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--rv-border);
    font-size: 14px;
    color: var(--rv-brown-soft);
  }

  #rv-contact-{{ section.id }} .rv-contact__support p {
    margin: 0 0 6px;
  }

  #rv-contact-{{ section.id }} .rv-contact__support strong {
    color: var(--rv-brown);
  }

  #rv-contact-{{ section.id }} .rv-contact__support a {
    color: var(--rv-gold-dark);
    text-decoration: underline;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser {
    margin-top: 28px;
    text-align: center;
    background: var(--rv-cream-deep);
    border: 1px solid var(--rv-border);
    border-radius: 16px;
    padding: 20px;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser-title {
    font-size: 15.5px;
    font-weight: 800;
    color: var(--rv-brown);
    margin: 0 0 6px;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser-text {
    font-size: 13.5px;
    color: var(--rv-brown-soft);
    margin: 0 0 14px;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    color: var(--rv-brown);
    background: #FFFDF8;
    border: 1px solid var(--rv-border);
    padding: 10px 18px;
    border-radius: 999px;
    transition: background 0.2s ease;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser-link:hover {
    background: #FFFFFF;
  }

  #rv-contact-{{ section.id }} .rv-contact__faq-teaser-link svg {
    width: 15px;
    height: 15px;
  }

  @media screen and (min-width: 600px) {
    #rv-contact-{{ section.id }} .rv-contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 750px) {
    #rv-contact-{{ section.id }} {
      padding: 64px 40px;
    }
    #rv-contact-{{ section.id }} .rv-contact__card {
      padding: 36px 40px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Send Us a Message"
    },
    {
      "type": "header",
      "content": "Support info"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@renivacare.com"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Support hours",
      "default": "Monday–Friday, 9am–6pm EST"
    },
    {
      "type": "header",
      "content": "FAQ teaser"
    },
    {
      "type": "text",
      "id": "faq_teaser_title",
      "label": "FAQ teaser title",
      "default": "Looking for a quick answer?"
    },
    {
      "type": "textarea",
      "id": "faq_teaser_text",
      "label": "FAQ teaser text",
      "default": "Check our most frequently asked questions about ingredients, results, and orders."
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "Link to product FAQ section",
      "info": "Paste your Reniva product page URL with #rv-faq at the end, e.g. /products/reniva#rv-faq"
    },
    {
      "type": "text",
      "id": "faq_link_label",
      "label": "FAQ link label",
      "default": "View FAQs"
    }
  ],
  "presets": [
    {
      "name": "Reniva Contact Form"
    }
  ]
}
{% endschema %}
