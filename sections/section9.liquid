<style>
  .xmirror-wrapper {
    background-color: #ffffff;
    border-bottom: 1px solid #000000;
  }

  .xmirror-grid {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0;
  }

  .xmirror-content {
    padding: 64px 64px;
  }

  .xmirror-heading {
    font-size: 34px;
    font-weight: 800;
    color: #000000;
    line-height: 1.25;
    margin: 0 0 20px;
  }

  .xmirror-paragraph {
    font-size: 14px;
    line-height: 1.7;
    color: #444444;
    margin: 0 0 36px;
    max-width: 480px;
  }

  .xmirror-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 24px;
    margin-bottom: 36px;
  }

  .xmirror-feature-title {
    font-size: 15px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 6px;
  }

  .xmirror-feature-desc {
    font-size: 13px;
    line-height: 1.6;
    color: #444444;
    margin: 0;
  }

  .xmirror-btn {
    display: inline-block;
    background-color: #000000;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 999px;
  }

  .xmirror-image {
    width: 100%;
    padding: 48px 48px 48px 0;
  }

  .xmirror-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }

  @media (max-width: 900px) {
    .xmirror-grid {
      grid-template-columns: 1fr;
    }

    .xmirror-content {
      order: 2;
      padding: 28px 20px 32px;
    }

    .xmirror-heading {
      font-size: 24px;
      margin-bottom: 14px;
    }

    .xmirror-paragraph {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .xmirror-features {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 24px;
    }

    .xmirror-feature-title {
      font-size: 14px;
    }

    .xmirror-feature-desc {
      font-size: 12px;
    }

    .xmirror-btn {
      font-size: 13px;
      padding: 14px 28px;
    }

    .xmirror-image {
      order: 1;
      padding: 24px 20px 16px;
    }

    .xmirror-image img {
      border-radius: 16px;
    }
  }
</style>

<div class="xmirror-wrapper">
  <div class="xmirror-grid">
    <div class="xmirror-content">
      <h2 class="xmirror-heading">{{ section.settings.heading }}</h2>
      <p class="xmirror-paragraph">{{ section.settings.paragraph }}</p>

      <div class="xmirror-features">
        {% for block in section.blocks %}
          <div class="xmirror-feature" {{ block.shopify_attributes }}>
            <p class="xmirror-feature-title">{{ block.settings.title }}</p>
            <p class="xmirror-feature-desc">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="xmirror-btn">{{ section.settings.button_text }}</a>
      {% endif %}
    </div>

    <div class="xmirror-image">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mirror Proof Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "El Espejo Es la Única Reseña Que Importa."
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph",
      "default": "En una observación independiente de 90 días, el 87% de usuarios constantes reportó una mejora visible — sienes más densas, coronilla más llena y mucho menos cabello en la almohada. El cambio es gradual y luego, de repente, imposible de ignorar."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alt text",
      "default": "Caja de producto Excalvo"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Comprar Ahora"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mirror Proof Section",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "La Caída Disminuye Rápido",
            "description": "Menos cabello en la regadera y la almohada en los primeros 21 a 30 días."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Crecimiento Nuevo, Cobertura Real",
            "description": "Cabellos nuevos en la línea capilar y la coronilla suelen aparecer entre la semana 8 y la 12."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Hebras Que Se Mantienen",
            "description": "Cada ciclo vuelve más grueso, más pigmentado y mucho más resistente a la rotura."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Evidencia, No Promesas",
            "description": "Cada activo se dosifica en concentraciones validadas en investigación clínica publicada."
          }
        }
      ]
    }
  ]
}
{% endschema %}