{% comment %}
  reniva-home-newsletter.liquid
  Standalone newsletter section for the homepage, mirroring the copy and
  visual style of the footer's email-signup block. Uses the same customer
  form + "newsletter" tag mechanism as the footer so signups behave
  identically wherever they happen on the site.
{% endcomment %}
<section class="rv-hnews" id="rv-hnews-{{ section.id }}">
  <div class="rv-hnews__inner">
    {% if section.settings.heading != blank %}
      <h2 class="rv-hnews__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <div class="rv-hnews__subtext">{{ section.settings.subtext }}</div>
    {% endif %}

    {%- form 'customer', id: 'ContactHomeNewsletter-' | append: section.id, class: 'rv-hnews__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="rv-hnews__field-row">
        <div class="rv-hnews__field">
          <input
            id="RvNewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="rv-hnews__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="RvNewsletterEmail-error-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="RvNewsletterEmail-success-{{ section.id }}"
            {% endif %}
            placeholder="{{ 'newsletter.label' | t }}"
            required
          >
          <label class="visually-hidden" for="RvNewsletterEmail-{{ section.id }}">
            {{ 'newsletter.label' | t }}
          </label>
        </div>
        <button type="submit" class="rv-hnews__btn" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
          {{ section.settings.button_label | default: 'Subscribe' }}
        </button>
      </div>

      {%- if form.errors -%}
        <small class="rv-hnews__message rv-hnews__message--error" id="RvNewsletterEmail-error-{{ section.id }}">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </small>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <small class="rv-hnews__message rv-hnews__message--success" id="RvNewsletterEmail-success-{{ section.id }}" tabindex="-1">
          {{ 'newsletter.success' | t }}
        </small>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% style %}
  #rv-hnews-{{ section.id }} {
    --rv-cream: #FBF3E4;
    --rv-gold: #C69B3B;
    --rv-gold-dark: #A87F2A;
    --rv-brown: #3E2A1E;

    background: var(--rv-brown);
    padding: 52px 20px;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__heading {
    font-size: clamp(24px, 4.5vw, 32px);
    font-weight: 800;
    color: var(--rv-cream);
    margin: 0 0 10px;
    letter-spacing: -0.4px;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__subtext {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(251, 243, 228, 0.82);
    margin: 0 0 26px;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__form {
    max-width: 440px;
    margin: 0 auto;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__field-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__field {
    flex: 1;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__input {
    width: 100%;
    box-sizing: border-box;
    font-size: 15px;
    padding: 14px 18px;
    border-radius: 999px;
    border: 1px solid rgba(251, 243, 228, 0.3);
    background: rgba(251, 243, 228, 0.08);
    color: var(--rv-cream);
  }

  #rv-hnews-{{ section.id }} .rv-hnews__input::placeholder {
    color: rgba(251, 243, 228, 0.6);
  }

  #rv-hnews-{{ section.id }} .rv-hnews__input:focus-visible {
    outline: 2px solid var(--rv-gold);
    outline-offset: 2px;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__btn {
    flex-shrink: 0;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 26px;
    border: none;
    border-radius: 999px;
    background: var(--rv-gold);
    color: #FFF9EF;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__btn:hover {
    background: var(--rv-gold-dark);
    transform: translateY(-1px);
  }

  #rv-hnews-{{ section.id }} .rv-hnews__message {
    display: block;
    margin-top: 12px;
    font-size: 12.5px;
    font-weight: 600;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__message--error {
    color: #E8A2A2;
  }

  #rv-hnews-{{ section.id }} .rv-hnews__message--success {
    color: var(--rv-gold);
  }

  @media screen and (min-width: 750px) {
    #rv-hnews-{{ section.id }} {
      padding: 72px 40px;
    }
    #rv-hnews-{{ section.id }} .rv-hnews__field-row {
      flex-direction: row;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Get 10% off your first order plus hair care tips.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Reniva Newsletter"
    }
  ]
}
{% endschema %}
