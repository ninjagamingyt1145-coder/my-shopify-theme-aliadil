<style>
  .xrev-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 64px 0 72px;
  }

  .xrev-inner {
    width: 100%;
    padding: 0 24px;
  }

  .xrev-header {
    text-align: center;
    margin-bottom: 40px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .xrev-heading {
    font-size: 36px;
    font-weight: 900;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .xrev-subheading {
    font-size: 16px;
    color: #555555;
    margin: 0 0 24px;
  }

  .xrev-badge {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    border: 2px solid #8b1a1a;
    border-radius: 12px;
    padding: 14px 28px;
    background: #ffffff;
  }

  .xrev-badge-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .xrev-badge-score {
    font-size: 28px;
    font-weight: 900;
    color: #1a1a1a;
    line-height: 1;
  }

  .xrev-badge-stars {
    color: #f5a623;
    font-size: 22px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .xrev-badge-divider {
    width: 1px;
    height: 36px;
    background: #e0e0e0;
  }

  .xrev-badge-right {
    text-align: left;
  }

  .xrev-badge-count {
    font-size: 15px;
    font-weight: 800;
    color: #1a1a1a;
    display: block;
    line-height: 1.3;
  }

  .xrev-badge-verified {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 700;
    color: #8b1a1a;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .xrev-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }

  .xrev-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }

  .xrev-card-top {
    padding: 18px 18px 14px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
  }

  .xrev-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .xrev-stars {
    color: #e53935;
    font-size: 18px;
    letter-spacing: 1px;
    line-height: 1;
  }

  .xrev-verified-badge {
    background-color: #8b1a1a;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .xrev-title {
    font-size: 15px;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .xrev-text {
    font-size: 13.5px;
    line-height: 1.65;
    color: #444444;
    margin: 0;
  }

  .xrev-photo-wrap {
    position: relative;
    width: 100%;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .xrev-photo-wrap img {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 3 / 4;
    border-radius: 12px 12px 0 0;
  }

  .xrev-weeks-badge {
    position: absolute;
    bottom: 12px;
    right: 28px;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 6px;
  }

  .xrev-card-bottom {
    padding: 12px 18px 16px;
  }

  .xrev-author {
    font-size: 14px;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0;
    display: inline;
  }

  .xrev-author-meta {
    font-size: 13px;
    color: #888888;
    margin: 0;
    display: inline;
  }

  @media (max-width: 900px) {
    .xrev-wrapper {
      padding: 36px 0 48px;
    }

    .xrev-inner {
      padding: 0 16px;
    }

    .xrev-heading {
      font-size: 24px;
    }

    .xrev-badge {
      flex-direction: column;
      gap: 10px;
      padding: 14px 20px;
    }

    .xrev-badge-divider {
      width: 80px;
      height: 1px;
    }

    .xrev-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .xrev-card-top {
      min-height: unset;
    }

    .xrev-photo-wrap {
      padding: 0 12px;
    }

    .xrev-weeks-badge {
      right: 24px;
    }
  }
</style>

<div class="xrev-wrapper">
  <div class="xrev-inner">
    <div class="xrev-header">
      <h2 class="xrev-heading">{{ section.settings.heading }}</h2>
      <p class="xrev-subheading">{{ section.settings.subheading }}</p>

      <div class="xrev-badge">
        <div class="xrev-badge-left">
          <span class="xrev-badge-score">{{ section.settings.rating }}</span>
          <span class="xrev-badge-stars">★★★★★</span>
        </div>
        <div class="xrev-badge-divider"></div>
        <div class="xrev-badge-right">
          <span class="xrev-badge-count">{{ section.settings.review_count }} verified reviews</span>
          <span class="xrev-badge-verified">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verified Reviews
          </span>
        </div>
      </div>
    </div>

    <div class="xrev-grid">
      {% for block in section.blocks %}
        <div class="xrev-card" {{ block.shopify_attributes }}>
          <div class="xrev-card-top">
            <div class="xrev-card-meta">
              <span class="xrev-stars">★★★★★</span>
              <span class="xrev-verified-badge">✓ Verified Purchase</span>
            </div>
            <p class="xrev-title">{{ block.settings.title }}</p>
            <p class="xrev-text">{{ block.settings.review }}</p>
          </div>

          {% if block.settings.image %}
            <div class="xrev-photo-wrap">
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.author }}" loading="lazy">
              {% if block.settings.weeks_label != blank %}
                <span class="xrev-weeks-badge">{{ block.settings.weeks_label }}</span>
              {% endif %}
            </div>
          {% endif %}

          <div class="xrev-card-bottom">
            <span class="xrev-author">{{ block.settings.author }}</span>
            <span class="xrev-author-meta"> · {{ block.settings.location }} · {{ block.settings.time_ago }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#eae8e1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results From Real Customers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join 55,000+ people who've transformed their bodies"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating score",
      "default": "4.7"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count label",
      "default": "55,000+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Game changer for my workouts"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review text",
          "default": "The sustained energy without the crash is incredible."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "weeks_label",
          "label": "Results badge (e.g. 6 Week Results)",
          "default": "6 Week Results"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Mike J."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Texas"
        },
        {
          "type": "text",
          "id": "time_ago",
          "label": "Time ago",
          "default": "3 days ago"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Section",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Game changer for my workouts",
            "review": "The sustained energy without the crash is incredible. I can push harder in the gym and still have energy for my kids after work. Down 8 lbs and feeling stronger than ever.",
            "weeks_label": "6 Week Results",
            "author": "Mike J.",
            "location": "Texas",
            "time_ago": "3 days ago"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "My only regret is not starting sooner",
            "review": "Within the first few days of taking it, the energy increase was real. I was able to go much harder in the gym, and that energy lasted throughout the day. After 31-days, I noticed the fat burning really started to kick in, my jeans felt much looser than before.",
            "weeks_label": "3 Week Results",
            "author": "Luke S.",
            "location": "USA",
            "time_ago": "1 week ago"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Finally something that actually works",
            "review": "I'm 40 and have tried everything. This is the only thing that's helped me lose that stubborn belly fat without feeling jittery or anxious. Lost 12 pounds in 6 weeks!",
            "weeks_label": "12 Week Results",
            "author": "Ryan B.",
            "location": "California",
            "time_ago": "2 weeks ago"
          }
        }
      ]
    }
  ]
}
{% endschema %}