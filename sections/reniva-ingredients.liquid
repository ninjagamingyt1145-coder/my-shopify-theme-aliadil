{% comment %} reniva-ingredients.liquid {% endcomment %}
<section class="rv-ingredients" id="rv-ingredients-{{ section.id }}">
  <div class="rv-ingredients__inner">
    <h2 class="rv-ingredients__title">{{ section.settings.title }}</h2>
    {% if section.settings.subtitle != blank %}
      <p class="rv-ingredients__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="rv-ingredients__grid">
      {% for block in section.blocks %}
        <div class="rv-ingredients__card" {{ block.shopify_attributes }}>
          <div class="rv-ingredients__image">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 500
                | image_tag:
                  loading: 'lazy',
                  class: 'rv-ingredients__img',
                  sizes: '(min-width: 990px) 200px, 40vw',
                  widths: '200, 300, 400, 500'
              }}
            {% else %}
              <div class="rv-ingredients__placeholder" role="img" aria-label="Ingredient image placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 20c8-1 13-6 15-15-9 1-14 6-15 15Z" stroke-linejoin="round"/>
                  <path d="M6 18c3-4 6-7 12-11" stroke-linecap="round"/>
                </svg>
              </div>
            {% endif %}
          </div>
          <h3 class="rv-ingredients__name">{{ block.settings.name }}</h3>
          <p class="rv-ingredients__desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.footnote != blank %}
      <p class="rv-ingredients__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% style %}
  #rv-ingredients-{{ section.id }} {
    background: #FFF9EF;
    padding: 56px 20px;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__inner {
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__title {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 800;
    color: #3E2A1E;
    margin: 0 0 12px;
    letter-spacing: -0.4px;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__subtitle {
    font-size: 16px;
    color: #6B4F3B;
    max-width: 560px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 36px;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__card {
    background: #FBF3E4;
    border: 1px solid #EEDFC0;
    border-radius: 20px;
    padding: 20px 18px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 140px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 16px;
    background: #FFFDF8;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C69B3B;
    border: 2px dashed #E7D6AF;
    border-radius: 16px;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__placeholder svg {
    width: 36px;
    height: 36px;
    opacity: 0.6;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__name {
    font-size: 16px;
    font-weight: 700;
    color: #3E2A1E;
    margin: 0 0 8px;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__desc {
    font-size: 13.5px;
    color: #6B4F3B;
    line-height: 1.55;
    margin: 0;
  }

  #rv-ingredients-{{ section.id }} .rv-ingredients__footnote {
    margin: 32px 0 0;
    font-size: 11.5px;
    color: #9C8367;
    text-align: center;
  }

  @media screen and (min-width: 600px) {
    #rv-ingredients-{{ section.id }} .rv-ingredients__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 750px) {
    #rv-ingredients-{{ section.id }} {
      padding: 80px 40px;
    }
  }

  @media screen and (min-width: 990px) {
    #rv-ingredients-{{ section.id }} .rv-ingredients__grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Reniva Ingredients",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "5 Botanical Ingredients Working Together"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every ingredient in Reniva is chosen for one job: helping you keep the hair you have."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "†These statements have not been evaluated by the Food and Drug Administration."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Ingredient name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of what this ingredient does."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reniva Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Thuja Orientalis Extract",
            "description": "A traditional botanical extract used for centuries in scalp care, concentrated to help calm irritation and reduce excessive hair fall at the root.†"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hydrolyzed Oat Protein",
            "description": "A clinically-studied protein compound that penetrates the hair shaft to strengthen roots and improve resistance to breakage with continued use.†"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Ginger Extract",
            "description": "Known for stimulating microcirculation at the scalp level, helping deliver nutrients to hair follicles for healthier, more active growth cycles.†"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Ginseng Extract",
            "description": "A revitalizing botanical shown to support follicle health and nourish the scalp, helping maintain a stronger foundation for hair growth.†"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Jojoba Oil",
            "description": "Structurally similar to the scalp's natural oils, jojoba oil deeply hydrates and softens hair while helping reduce breakage and split ends.†"
          }
        }
      ]
    }
  ]
}
{% endschema %}
