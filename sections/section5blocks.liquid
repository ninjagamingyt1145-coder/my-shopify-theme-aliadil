<style>
  .xwhy-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 64px 24px 72px;
  }

  .xwhy-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .xwhy-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .xwhy-heading {
    font-size: 42px;
    font-weight: 900;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .xwhy-subheading {
    font-size: 16px;
    color: #777777;
    margin: 0;
  }

  .xwhy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .xwhy-card {
    background: #ffffff;
    border: 1.5px solid {{ section.settings.border_color }};
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .xwhy-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .xwhy-card-icon {
    font-size: 48px;
    line-height: 1;
    margin-bottom: 20px;
    display: block;
  }

  .xwhy-card-title {
    font-size: 16px;
    font-weight: 900;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .xwhy-card-underline {
    display: block;
    width: 36px;
    height: 3px;
    background-color: {{ section.settings.border_color }};
    margin-bottom: 14px;
    border-radius: 2px;
  }

  .xwhy-card-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #555555;
    margin: 0;
  }

  @media (max-width: 900px) {
    .xwhy-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .xwhy-heading {
      font-size: 28px;
    }

    .xwhy-card {
      padding: 24px 20px;
    }

    .xwhy-card-icon {
      font-size: 36px;
      margin-bottom: 16px;
    }

    .xwhy-card-title {
      font-size: 14px;
    }

    .xwhy-card-desc {
      font-size: 13px;
    }
  }

  @media (max-width: 560px) {
    .xwhy-wrapper {
      padding: 40px 16px 48px;
    }

    .xwhy-header {
      margin-bottom: 28px;
    }

    .xwhy-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .xwhy-heading {
      font-size: 22px;
    }

    .xwhy-subheading {
      font-size: 14px;
    }
  }
</style>

<div class="xwhy-wrapper">
  <div class="xwhy-inner">
    <div class="xwhy-header">
      <h2 class="xwhy-heading">{{ section.settings.heading }}</h2>
      <p class="xwhy-subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="xwhy-grid">
      {% for block in section.blocks %}
        <div class="xwhy-card" data-xwhy-card {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <span class="xwhy-card-icon">{{ block.settings.icon }}</span>
          {% endif %}
          <p class="xwhy-card-title">{{ block.settings.title }}</p>
          <span class="xwhy-card-underline"></span>
          <p class="xwhy-card-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    function initXwhy() {
      var cards = document.querySelectorAll('[data-xwhy-card]');
      if (!cards.length) return;

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry, i) {
            if (entry.isIntersecting) {
              var card = entry.target;
              var index = Array.from(cards).indexOf(card);
              setTimeout(function () {
                card.classList.add('is-visible');
              }, index * 100);
              observer.unobserve(card);
            }
          });
        }, { threshold: 0.15 });

        cards.forEach(function (card) {
          observer.observe(card);
        });
      } else {
        cards.forEach(function (card) {
          card.classList.add('is-visible');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initXwhy);
    } else {
      initXwhy();
    }

    document.addEventListener('shopify:section:load', initXwhy);
  })();
</script>

