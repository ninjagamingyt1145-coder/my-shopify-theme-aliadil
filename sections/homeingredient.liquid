{% comment %} ingredients-grid.liquid {% endcomment %}
 {% if request.page_type == 'index' %}
<section class="ig-section" style="background: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="ig-container">
    <h2 class="ig-heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    {%- comment -%} DESKTOP: 3-column grid {%- endcomment -%}
    <div class="ig-grid">
      {% for block in section.blocks %}
        <div class="ig-card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="ig-img-wrap">
              <img src="{{ block.settings.image | img_url: '600x400', crop: 'center' }}" alt="{{ block.settings.title }}" class="ig-img" loading="lazy">
            </div>
          {% endif %}
          <div class="ig-card-body">
            <h3 class="ig-title" style="color: {{ section.settings.title_color }};">{{ block.settings.title }}</h3>
            <p class="ig-desc" style="color: {{ section.settings.text_color }};" data-full="{{ block.settings.description | escape }}">{{ block.settings.description }}</p>
            <div class="ig-tags">
              {% assign tags = block.settings.tags | split: ',' %}
              {% for tag in tags %}
                <span class="ig-tag" style="border-color: {{ section.settings.tag_border_color }}; color: {{ section.settings.tag_text_color }};">{{ tag | strip }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} MOBILE: horizontal swipe slider {%- endcomment -%}
    <div class="ig-slider-wrap">
      <div class="ig-slider-track">
        {% for block in section.blocks %}
          <div class="ig-slide" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <div class="ig-img-wrap">
                <img src="{{ block.settings.image | img_url: '600x400', crop: 'center' }}" alt="{{ block.settings.title }}" class="ig-img" loading="lazy">
              </div>
            {% endif %}
            <div class="ig-card-body">
              <h3 class="ig-title" style="color: {{ section.settings.title_color }};">{{ block.settings.title }}</h3>
              <p class="ig-desc" style="color: {{ section.settings.text_color }};" data-full="{{ block.settings.description | escape }}">{{ block.settings.description }}</p>
              <div class="ig-tags">
                {% assign tags = block.settings.tags | split: ',' %}
                {% for tag in tags %}
                  <span class="ig-tag" style="border-color: {{ section.settings.tag_border_color }}; color: {{ section.settings.tag_text_color }};">{{ tag | strip }}</span>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>
  {% endif %}
<style>
.ig-section {
  background: #f5f5f5;
}
.ig-container {
  width: 100%;
  padding: 0 24px;
  box-sizing: border-box;
}
.ig-heading {
  font-size: clamp(22px, 3vw, 36px);
  font-weight: 800;
  margin: 0 0 32px;
  line-height: 1.2;
  color: #111;
}

/* ── DESKTOP GRID ── */
.ig-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.ig-slider-wrap {
  display: none;
}

/* ── CARD SHARED ── */
.ig-card,
.ig-slide {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  display: flex;
  flex-direction: column;
}
.ig-img-wrap {
  width: 100%;
  height: 240px;
  overflow: hidden;
  flex-shrink: 0;
}
.ig-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.ig-card-body {
  padding: 16px 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.ig-title {
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  color: #111;
}
.ig-desc {
  font-size: 14px;
  line-height: 1.6;
  margin: 0;
  color: #444;
}
.ig-read-more {
  background: none;
  border: none;
  padding: 0;
  margin-left: 2px;
  font-size: 14px;
  text-decoration: underline;
  color: #111;
  cursor: pointer;
  font-family: inherit;
}
.ig-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}
.ig-tag {
  font-size: 12px;
  border: 1px solid #bbb;
  border-radius: 999px;
  padding: 3px 12px;
  color: #444;
  white-space: nowrap;
}

/* ── MOBILE SLIDER ── */
@media (max-width: 700px) {
  .ig-grid {
    display: none;
  }
  .ig-slider-wrap {
    display: block;
    overflow: hidden;
  }
  .ig-slider-track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    scrollbar-width: none;
  }
  .ig-slider-track::-webkit-scrollbar {
    display: none;
  }
  .ig-slide {
    flex: 0 0 75vw;
    max-width: 300px;
    scroll-snap-align: start;
  }
  .ig-img-wrap {
    height: 180px;
  }
  .ig-title {
    font-size: 15px;
  }
  .ig-desc {
    font-size: 12px;
  }
  .ig-read-more {
    font-size: 12px;
  }
  .ig-tag {
    font-size: 11px;
    padding: 2px 10px;
  }
  .ig-heading {
    font-size: 20px;
    margin-bottom: 20px;
  }
}
</style>

<script>
(function () {
  var LIMIT = 100;

  function initDesc(p) {
    var full = p.getAttribute('data-full') || p.textContent.trim();
    p.setAttribute('data-full', full);

    if (full.length <= LIMIT) return;

    var short = full.slice(0, LIMIT).trimEnd();

    var btn = document.createElement('button');
    btn.className = 'ig-read-more';
    btn.setAttribute('aria-expanded', 'false');
    btn.textContent = 'read more';

    p.textContent = short + '… ';
    p.appendChild(btn);

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        p.textContent = short + '… ';
        p.appendChild(btn);
        btn.textContent = 'read more';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        p.textContent = full + ' ';
        p.appendChild(btn);
        btn.textContent = 'read less';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  document.querySelectorAll('.ig-desc').forEach(initDesc);
})();
</script>

