{% doc %}
  @prompt
    Create a premium custom Shopify Liquid section called "Product Feature Breakdown Grid". It features a clean 2-column split on desktop (Image on the left, interactive feature layout on the right) that beautifully stacks on mobile.
    
    Design and Layout Specifications:
    1. LEFT COLUMN (Product Main Showcase):
       - A modern rounded-corner container (`border-radius: 16px`) holding a high-quality product package or context lifestyle image.
    
    2. RIGHT COLUMN (Feature Text & Floating Capsule Layout):
       - Top Section: A bold, high-converting headline (font-size: 28px-36px) focusing on how the product stands out ("Unlike regular pills..."), with a brief descriptive paragraph underneath.
       - Bottom Section (The Interactive Feature Pointer Grid): A custom layout that holds blocks of specific product features.
       - Crucially, it must support a floating accent asset image (e.g., a dynamic transparent capsule/softgel cut-out image) placed elegantly between or next to the feature texts.
       - Each feature text block should have a thin accent line or pointer indicator styling (top border or subtle side vector line in a brand accent color) to direct the user's eye, displaying a clean sub-heading and micro-copy description.
    
    3. STYLING & RESPONSIVENESS:
       - Modern clean aesthetics with plenty of whitespace. The entire right block must have a soft rounded card background (#f9f9f9 or custom color) to separate it from the main page background.
       - Typography: Premium sans-serif styling with strict line-heights (1.3 for headings, 1.5 for copy blocks) for ultimate scannability.
       - On mobile screens, the layout must stack cleanly into 1 column: Left image element displays first, followed by the main headings, the standalone capsule image, and then the feature list.
    
    4. SHOPIFY SCHEMA Settings:
       - Dynamic configurations for: Main Left Product Image, Right Section Card Background Color, Main Section Heading and Paragraph texts.
       - Dynamic block configurations for the individual feature highlights (Title and Description fields per block).
       - An independent settings field (`image_picker`) specifically to upload the floating spotlight element (the capsule/softgel asset).
       - Sliders for section padding top/bottom and custom default presets so it can be added seamlessly via the customizer., on mobile remove heading margin top and on desktop remove heading margin bottom, between heading and description theres alot of space why remove, please remove Capsule spotlight image margin top, why so much space please remove between heading and description i dont want to much space remove down space of description also
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    overflow: hidden; /* Prevents any animation scrollbars */
  }

  .ai-feature-grid-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-feature-grid-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: flex-start;
  }

  /* ENTRY ANIMATION BASE STATES */
  .ai-animate-fade-up-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1), transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Stagger reveal sequence for left and right columns */
  .ai-feature-grid-image-column-{{ ai_gen_id }}.ai-animate-fade-up-{{ ai_gen_id }} {
    transition-delay: 0.1s;
  }
  .ai-feature-grid-content-column-{{ ai_gen_id }}.ai-animate-fade-up-{{ ai_gen_id }} {
    transition-delay: 0.25s;
  }

  /* Triggered when element enters viewport */
  .ai-animate-fade-up-{{ ai_gen_id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-feature-grid-image-column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-feature-grid-image-wrapper-{{ ai_gen_id }} {
    border-radius: 16px;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-feature-grid-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-feature-grid-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 16px;
    position: relative;
  }

  .ai-feature-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-feature-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-feature-grid-content-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-feature-grid-header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px !important;
    margin: 0 0 5px 0 !important;
  }

  .ai-feature-grid-header-{{ ai_gen_id }} p,
  .ai-feature-grid-header-{{ ai_gen_id }} h1,
  .ai-feature-grid-header-{{ ai_gen_id }} h2,
  .ai-feature-grid-header-{{ ai_gen_id }} h3 {
    margin: 0 !important;
    padding: 0 !important;
  }

  .ai-feature-grid-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0 !important;
    padding: 0 !important;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  .ai-feature-grid-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
    margin: 0 !important;
    padding: 0 !important;
  }

  .ai-feature-grid-features-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: 16px;
    padding: 30px;
    position: relative;
  }

  .ai-feature-grid-capsule-wrapper-{{ ai_gen_id }} {
    position: relative;
    margin-top: 0 !important;
    margin-bottom: 15px !important;
    display: flex;
    justify-content: center;
  }

  .ai-feature-grid-capsule-image-{{ ai_gen_id }} {
    max-width: 140px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .ai-feature-grid-capsule-placeholder-{{ ai_gen_id }} {
    width: 140px;
    height: 65px;
    background-color: #e8e8e8;
    border-radius: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-feature-grid-capsule-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    opacity: 0.3;
  }

  .ai-feature-grid-capsule-empty-{{ ai_gen_id }} {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: #999;
    white-space: nowrap;
  }

  .ai-feature-grid-features-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-feature-grid-feature-item-{{ ai_gen_id }} {
    position: relative;
    padding-top: 12px;
    border-top: 1.5px solid {{ block.settings.accent_color }};
  }

  .ai-feature-grid-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-feature-grid-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_description_size }}px;
    line-height: 1.4;
    margin: 0;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-grid-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-feature-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-feature-grid-features-section-{{ ai_gen_id }} {
      padding: 25px 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-grid-content-column-{{ ai_gen_id }} {
      gap: 15px;
    }

    .ai-feature-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
      margin-top: 0px !important;
      margin-bottom: 0px !important;
    }

    .ai-feature-grid-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.95);
      margin-bottom: 0px !important;
    }

    .ai-feature-grid-features-section-{{ ai_gen_id }} {
      padding: 20px 15px;
    }

    .ai-feature-grid-capsule-image-{{ ai_gen_id }} {
      max-width: 110px;
    }

    .ai-feature-grid-capsule-placeholder-{{ ai_gen_id }} {
      width: 110px;
      height: 50px;
    }
  }
{% endstyle %}

<product-feature-grid-{{ ai_gen_id }}
  class="ai-feature-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-feature-grid-container-{{ ai_gen_id }}">
    <div class="ai-feature-grid-layout-{{ ai_gen_id }}">
      
      <div class="ai-feature-grid-image-column-{{ ai_gen_id }} ai-animate-fade-up-{{ ai_gen_id }}">
        <div class="ai-feature-grid-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.main_image %}
            <img
              src="{{ block.settings.main_image | image_url: width: 1000 }}"
              alt="{{ block.settings.main_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.main_image.width }}"
              height="{{ block.settings.main_image.height }}"
            >
          {% else %}
            <div class="ai-feature-grid-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
              <div class="ai-feature-grid-empty-state-{{ ai_gen_id }}">
                Add your product image
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-feature-grid-content-column-{{ ai_gen_id }} ai-animate-fade-up-{{ ai_gen_id }}">
        <div class="ai-feature-grid-header-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <div class="ai-feature-grid-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ai-feature-grid-description-{{ ai_gen_id }}">
              {{ block.settings.description }}
            </div>
          {% endif %}
        </div>

        <div class="ai-feature-grid-features-section-{{ ai_gen_id }}">
          {% if block.settings.capsule_image or block.settings.show_capsule_placeholder %}
            <div class="ai-feature-grid-capsule-wrapper-{{ ai_gen_id }}">
              {% if block.settings.capsule_image %}
                <img
                  src="{{ block.settings.capsule_image | image_url: width: 400 }}"
                  alt="{{ block.settings.capsule_image.alt | escape }}"
                  loading="lazy"
                  class="ai-feature-grid-capsule-image-{{ ai_gen_id }}"
                  width="{{ block.settings.capsule_image.width }}"
                  height="{{ block.settings.capsule_image.height }}"
                >
              {% else %}
                <div class="ai-feature-grid-capsule-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                  <div class="ai-feature-grid-capsule-empty-{{ ai_gen_id }}">
                    Add capsule image
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}

          <div class="ai-feature-grid-features-list-{{ ai_gen_id }}">
            {% if block.settings.feature_1_title != blank %}
              <div class="ai-feature-grid-feature-item-{{ ai_gen_id }}">
                <h3 class="ai-feature-grid-feature-title-{{ ai_gen_id }}">
                  {{ block.settings.feature_1_title }}
                </h3>
                {% if block.settings.feature_1_description != blank %}
                  <div class="ai-feature-grid-feature-description-{{ ai_gen_id }}">
                    {{ block.settings.feature_1_description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.feature_2_title != blank %}
              <div class="ai-feature-grid-feature-item-{{ ai_gen_id }}">
                <h3 class="ai-feature-grid-feature-title-{{ ai_gen_id }}">
                  {{ block.settings.feature_2_title }}
                </h3>
                {% if block.settings.feature_2_description != blank %}
                  <div class="ai-feature-grid-feature-description-{{ ai_gen_id }}">
                    {{ block.settings.feature_2_description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.feature_3_title != blank %}
              <div class="ai-feature-grid-feature-item-{{ ai_gen_id }}">
                <h3 class="ai-feature-grid-feature-title-{{ ai_gen_id }}">
                  {{ block.settings.feature_3_title }}
                </h3>
                {% if block.settings.feature_3_description != blank %}
                  <div class="ai-feature-grid-feature-description-{{ ai_gen_id }}">
                    {{ block.settings.feature_3_description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.feature_4_title != blank %}
              <div class="ai-feature-grid-feature-item-{{ ai_gen_id }}">
                <h3 class="ai-feature-grid-feature-title-{{ ai_gen_id }}">
                  {{ block.settings.feature_4_title }}
                </h3>
                {% if block.settings.feature_4_description != blank %}
                  <div class="ai-feature-grid-feature-description-{{ ai_gen_id }}">
                    {{ block.settings.feature_4_description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.feature_5_title != blank %}
              <div class="ai-feature-grid-feature-item-{{ ai_gen_id }}">
                <h3 class="ai-feature-grid-feature-title-{{ ai_gen_id }}">
                  {{ block.settings.feature_5_title }}
                </h3>
                {% if block.settings.feature_5_description != blank %}
                  <div class="ai-feature-grid-feature-description-{{ ai_gen_id }}">
                    {{ block.settings.feature_5_description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</product-feature-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeatureGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
        this.initAnimation();
      }

      initAnimation() {
        const animatedElements = this.querySelectorAll('.ai-animate-fade-up-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // Animates once per scroll session
              }
            });
          }, {
            threshold: 0.15, // Triggers when 15% of element is in viewport
            rootMargin: '0px 0px -50px 0px'
          });

          animatedElements.forEach(el => observer.observe(el));
        } else {
          // Fallback if browser doesn't support observer
          animatedElements.forEach(el => el.classList.add('is-visible'));
        }
      }
    }

    customElements.define('product-feature-grid-{{ ai_gen_id }}', ProductFeatureGrid{{ ai_gen_id }});
  })();
</script>

