{% doc %}
  @prompt
    A minimalist website header section with a solid white background. The layout is perfectly symmetrical with a large placeholder space in the exact center for a brand logo. No navigation links, no search icons, and no cart buttons visible. The design is ultra-clean, modern, and high-end, focusing on maximum white space and a premium boutique feel. High-resolution UI/UX web design template., please decrease vertical padding, decrease more vertical padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-minimal-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-minimal-header__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-minimal-header__logo-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ai-minimal-header__logo-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-minimal-header__logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_width | times: 0.3 }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-minimal-header__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-minimal-header__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    white-space: nowrap;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-minimal-header-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px 0;
    }

    .ai-minimal-header__logo-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_width }}px;
    }

    .ai-minimal-header__logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_width }}px;
      height: {{ block.settings.mobile_logo_width | times: 0.3 }}px;
    }
  }
{% endstyle %}
{% if request.page_type == 'page' and handle == 'listicle-3' %}
<minimal-header-{{ ai_gen_id }}
  class="ai-minimal-header-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-minimal-header__container-{{ ai_gen_id }}">
    <div class="ai-minimal-header__logo-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 800 }}"
          alt="{{ shop.name }}"
          class="ai-minimal-header__logo-{{ ai_gen_id }}"
          width="{{ block.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {% else %}
        <div class="ai-minimal-header__logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-minimal-header__empty-state-{{ ai_gen_id }}">
            Add your logo
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</minimal-header-{{ ai_gen_id }}>

<script>
  (function() {
    class MinimalHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('minimal-header-{{ ai_gen_id }}', MinimalHeader{{ ai_gen_id }});
  })();
</script>
{% endif %}
{% schema %}
{
  "name": "Minimal header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Desktop vertical padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_vertical_padding",
      "label": "Mobile vertical padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Minimal header4"
    }
  ],
  "tag": null
}
{% endschema %}
