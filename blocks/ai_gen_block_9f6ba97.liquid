{% doc %}
  @prompt
    "Create a product feature section with a two-column layout.
    
    Left Column: Display an image of a product supplement pouch titled 'Elaré Odorless Aged Garlic Extract'. Ensure the visual style includes soft, clean, wellness-oriented branding.
    
    Right Column: > - Rating: Display a 4.6-star rating labeled 'Rated 4.6 Excellent'.
    
    Heading: Use the text 'Daily Wellness Support'.
    
    Subheading: Use the text '❤ Odorless Aged Garlic Extract'.
    
    Body Text: 'Support overall cardiovascular wellness and daily vitality with 7,500 mg garlic equivalent, slow-aged for up to 24 months and gentle enough for everyday use.'
    
    Call to Action: Include a prominent 'SHOP NOW' button with a dark red background.
    
    Footer: Add a small trust indicator below the button with a pin icon and the text '30-day money-back guarantee'.", "Refine the styling for the 'SHOP NOW' button. Please increase its padding to be significantly larger and more prominent. Set the button width to a minimum of 250px, use a bold font for the text, and ensure the button color is a solid, bold red that stands out from the rest of the content. The goal is to make the button look like a primary, high-conversion CTA with more visual weight than the surrounding text.", increase button horizontal length and align button in center, make image size little small and on mobile align all text on center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-feature-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_width_percent }}% 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
    max-width: 100%;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-product-feature-image-column-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-product-feature-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-product-feature-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-feature-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-product-feature-content-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-product-feature-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.rating_font_size }}px;
    color: {{ block.settings.rating_text_color }};
  }

  .ai-product-feature-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-product-feature-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-product-feature-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-product-feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-feature-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-feature-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_font_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.6;
  }

  .ai-product-feature-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-product-feature-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-product-feature-trust-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.trust_font_size }}px;
    color: {{ block.settings.trust_text_color }};
  }

  .ai-product-feature-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.trust_icon_size }}px;
    height: {{ block.settings.trust_icon_size }}px;
    fill: {{ block.settings.trust_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-feature-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-product-feature-content-column-{{ ai_gen_id }} {
      text-align: center;
      align-items: center;
    }

    .ai-product-feature-rating-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-product-feature-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.8 }}px;
    }

    .ai-product-feature-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.9 }}px;
    }

    .ai-product-feature-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_font_size | times: 0.9 }}px;
    }

    .ai-product-feature-trust-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<product-feature-{{ ai_gen_id }} class="ai-product-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-feature-container-{{ ai_gen_id }}">
    <div class="ai-product-feature-image-column-{{ ai_gen_id }}">
      <div class="ai-product-feature-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1000 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-product-feature-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-product-feature-content-column-{{ ai_gen_id }}">
      {% if block.settings.show_rating %}
        <div class="ai-product-feature-rating-{{ ai_gen_id }}">
          <div class="ai-product-feature-stars-{{ ai_gen_id }}">
            {% assign full_stars = block.settings.rating_value | floor %}
            {% assign has_half_star = false %}
            {% assign decimal = block.settings.rating_value | modulo: 1 %}
            {% if decimal >= 0.5 %}
              {% assign has_half_star = true %}
            {% endif %}
            {% assign next_star_index = full_stars | plus: 1 %}

            {% for i in (1..5) %}
              {% if i <= full_stars %}
                <svg class="ai-product-feature-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% elsif i == next_star_index and has_half_star %}
                <svg class="ai-product-feature-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="half-{{ ai_gen_id }}">
                      <stop offset="50%" stop-color="{{ block.settings.star_color }}"/>
                      <stop offset="50%" stop-color="{{ block.settings.star_empty_color }}"/>
                    </linearGradient>
                  </defs>
                  <path fill="url(#half-{{ ai_gen_id }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% else %}
                <svg class="ai-product-feature-star-{{ ai_gen_id }} ai-product-feature-star-empty-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endif %}
            {% endfor %}
          </div>
          <span>{{ block.settings.rating_text }}</span>
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-product-feature-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h3 class="ai-product-feature-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-product-feature-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <div>
          <a href="{{ block.settings.cta_link }}" class="ai-product-feature-cta-{{ ai_gen_id }}">
            {{ block.settings.cta_text }}
          </a>
        </div>
      {% endif %}

      {% if block.settings.show_trust_badge %}
        <div class="ai-product-feature-trust-{{ ai_gen_id }}">
          <svg class="ai-product-feature-trust-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
          </svg>
          <span>{{ block.settings.trust_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</product-feature-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductFeature{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('product-feature-{{ ai_gen_id }}', ProductFeature{{ ai_gen_id }});
  })();
</script>

