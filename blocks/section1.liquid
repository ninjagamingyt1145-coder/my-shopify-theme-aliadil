{% doc %}
  @prompt
    Create a Shopify section with 4 benefit cards in one row (desktop) and responsive for mobile.  
    Each card should have an image on top, a heading, and a short description below it.
    
    Section title: "4 Clinically Studied Benefits of Aged Garlic".
    
    Design requirements:
    - Background color: light grey
    - No margin-top and no margin-bottom for the section
    - Rounded card corners
    - Clean minimal supplement style
    - Equal spacing between cards
    - Center aligned text
    
    Important styling:
    - The words "Aged Garlic" in the section title should have a different color (dark red or brown) while the rest of the title remains black.
    
    Cards:
    
    Card 1  
    Heading: Aged Garlic Extract  
    Text: Slow-aged garlic extract delivering the equivalent of 7,500 mg of garlic per serving, designed for daily use without odor or digestive discomfort.
    
    Card 2  
    Heading: S-Allyl-Cysteine (SAC)  
    Text: S-allyl-cysteine develops through extended aging and is associated with many of the studied properties of aged garlic.
    
    Card 3  
    Heading: Odorless Formula  
    Text: Designed for people who want garlic support without the harsh effects of raw or standard garlic supplements.
    
    Card 4  
    Heading: Clean & Tested Quality  
    Text: Every batch is third-party lab tested for purity and potency to meet clean supplement standards.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* Entry load fade animation */
  @keyframes aiFadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    margin: 0;
    /* Animation applied smoothly here */
    animation: aiFadeInUp 0.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-benefits-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_font_size }}px;
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-benefits-title-{{ ai_gen_id }} .highlight {
    color: {{ block.settings.highlight_color }};
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-benefit-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-benefit-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 | divided_by: 100.0 }});
  }

  .ai-benefit-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_margin_bottom }}px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-benefit-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-benefit-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-benefit-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-benefit-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.card_heading_color }};
  }

  .ai-benefit-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.card_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-benefits-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-benefit-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_heading_size | times: 0.9 }}px;
    }

    .ai-benefit-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_text_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<benefit-cards-{{ ai_gen_id }} class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-benefits-title-{{ ai_gen_id }}">
        {{ block.settings.section_title | replace: 'Spiny Bitter Gourd', '<span class="highlight">Spiny Bitter Gourd</span>' }}
      </h2>
    {% endif %}

    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_heading_key = 'card_' | append: i | append: '_heading'
          assign card_text_key = 'card_' | append: i | append: '_text'

          assign card_image = block.settings[card_image_key]
          assign card_heading = block.settings[card_heading_key]
          assign card_text = block.settings[card_text_key]
        %}

        <div class="ai-benefit-card-{{ ai_gen_id }}">
          <div class="ai-benefit-image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 600 }}"
                alt="{{ card_heading | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-benefit-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if card_heading != blank %}
            <h3 class="ai-benefit-heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
          {% endif %}

          {% if card_text != blank %}
            <p class="ai-benefit-text-{{ ai_gen_id }}">{{ card_text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</benefit-cards-{{ ai_gen_id }}>

<script>
  (function() {
    class BenefitCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('benefit-cards-{{ ai_gen_id }}', BenefitCards{{ ai_gen_id }});
  })();
</script>

