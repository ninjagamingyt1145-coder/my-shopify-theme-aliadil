{% doc %}
  @prompt
    a thin line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-thin-line-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-thin-line-inner-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    opacity: {{ block.settings.line_opacity | divided_by: 100.0 }};
  }

  @media screen and (max-width: 749px) {
    .ai-thin-line-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-thin-line-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-thin-line-inner-{{ ai_gen_id }}"></div>
</div>

{% schema %}
{
  "name": "Thin line",
  "settings": [
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "line_opacity",
      "label": "Line opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Thin line"
    }
  ]
}
{% endschema %}
