{% doc %}
  @prompt
    "Create a custom Shopify Liquid section for a blog body with a two-column split layout where the image is on the right.
    Section Styling: Light blue-grey background
    (#F4F7F9) with 60px vertical padding.
    2. Layout: Split the section into two columns. On desktop, text is on the left and image is on the right. On mobile, stack them with the image on top.
    3. Left Column (Text & Button):
    • Heading: A bold H2 heading: '2. It Doesn't Fix The Problem (It Just Masks The Symptoms)'.
    • Paragraphs: > * 'Minoxidil widens blood
    vessels. More blood flow = temporary growth.'
    • 'But male pattern baldness isn't caused by poor blood flow. It's caused by DHT hormone strangling your follicles. Minoxidil does nothing about DHT!' • 'You're treating symptoms while the root cause keeps destroying your hair.'
    • Button: Below the text, add a large, rounded button with a solid blue background
    (#3B5998) and white text that says: 'BLOCK DHT AT THE SOURCE. Center the button relative to the text.
    4. Right Column (Image):
    • Add a placeholder for a detailed medical-style
    3D illustration. The image should be square/ rectangular with rounded corners (8px).
    5. Alignment: Vertically center the text and button column so it aligns with the middle of the image.
    6. Customizability: Make the heading, all paragraph text, the button link/text, and the image fully editable.", remove margin top, why space up of paragraph remove it, remove gap of paragraph , remove heading margin bottom, remove margin top of paragraphs, just show image remove image border radius container just square image , make image size small not that big just square size image, remove margin top of heading and image, remove little bit margin bottom, remove margin bottom, add a little bit margin bottom, make a button size little bit small, add a little bit margin bottom, add a little bit margin top, remove heading margin bottom a little bit, reduces a little bit gap between paragraphs, remove button, align section in middle , align image and heading the the same row, remove heading margin bottom, descrease paragrapgh margin top a little bit
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-split-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-blog-split-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-split-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    justify-items: center;
  }

  .ai-blog-split-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 600px;
  }

  .ai-blog-split-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    line-height: 1.3;
    margin: 0 0 {{ block.settings.text_gap }}px 0;
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.paragraph_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.paragraph_gap }}px 0;
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-blog-split-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .ai-blog-split-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    height: auto;
    display: block;
  }

  .ai-blog-split-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-split-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-split-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-blog-split-image-wrapper-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-blog-split-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-blog-split-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.paragraph_size | times: 0.9 }}px;
    }

    .ai-blog-split-image-{{ ai_gen_id }},
    .ai-blog-split-placeholder-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}
{% if request.page_type == 'page' and handle == 'listicle-1' %}
<div class="ai-blog-split-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-split-container-{{ ai_gen_id }}">
    <div class="ai-blog-split-layout-{{ ai_gen_id }}">
      <div class="ai-blog-split-text-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-split-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.paragraph_1 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_1 }}</div>
        {% endif %}

        {% if block.settings.paragraph_2 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_2 }}</div>
        {% endif %}

        {% if block.settings.paragraph_3 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">{{ block.settings.paragraph_3 }}</div>
        {% endif %}
      </div>

      <div class="ai-blog-split-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-blog-split-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-blog-split-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "Blog split layout",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F7F9"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>2. It Doesn't Fix The Problem (It Just Masks The Symptoms)</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Paragraphs"
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>Minoxidil widens blood vessels. More blood flow = temporary growth.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>But male pattern baldness isn't caused by poor blood flow. It's caused by DHT hormone strangling your follicles. Minoxidil does nothing about DHT!</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "<p>You're treating symptoms while the root cause keeps destroying your hair.</p>"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "label": "Paragraph size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Space after heading",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "paragraph_gap",
      "label": "Space between paragraphs",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Blog split layout2"
    }
  ]
}
{% endschema %}
