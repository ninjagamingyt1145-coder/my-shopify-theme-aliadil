{% doc %}
  @prompt
    "Create a centered single-column section on a dark background.
    
    Typography: Use a wide, futuristic monospaced font for all text. The main heading should be 'Stop the donate-and-pray cycle. Manage your bloodwork like a professional.' in a larger size with tight line height. The sub-text below it should be smaller and say: 'Hemo Flow is available now at buy two get one free with a full money-back guarantee. If your numbers don’t improve, send it back. But they will.'
    
    Image Styling: Below the text, include a medium-sized centered image with rounded corners. The image should feature a product bottle with a badge.
    
    Button Styling: Place a ghost-style button (transparent background with a thin border) at the very bottom. The button text should be 'GET OUR BUY 2 GET 1 FREE DEAL' in all caps.
    
    Spacing: Ensure all elements are center-aligned. Use minimal vertical spacing between the heading, the sub-text, and the image to keep the section compact.", button background color should be white
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-promo-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.element_spacing }}px;
  }

  .ai-promo-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, monospace;
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-promo-subtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtext_font.family }}, monospace;
    font-weight: {{ block.settings.subtext_font.weight }};
    font-size: {{ block.settings.subtext_size }}px;
    line-height: {{ block.settings.subtext_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-promo-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
  }

  .ai-promo-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-promo-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
  }

  .ai-promo-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-promo-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.button_font.family }}, monospace;
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_bg_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: uppercase;
  }

  .ai-promo-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-promo-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-promo-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.85 }}px;
    }

    .ai-promo-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.85 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}
{% if request.page_type == 'page' and handle == 'listicle-2' %}
<div class="ai-promo-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-promo-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-promo-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    <div class="ai-promo-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img
          src="{{ block.settings.product_image | image_url: width: 800 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          class="ai-promo-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
        >
      {% else %}
        <div class="ai-promo-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-promo-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>
{% endif %}
