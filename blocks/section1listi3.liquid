{% doc %}
  @prompt
    “Create a two-column section with a clean layout. The left column should contain a single image that fills the space. The right column must contain the following text elements: a main heading, a short description paragraph, and a button, all aligned to the center within their column.
    Heading Text: '5 Signs Your Blood Isn't Moving the Way It Should And the One Formula Men Are Using to Fix It'
    Heading Style: Bold, red/orange color, large font size, compact line height (line spacing).
    Description Text: 'Most men blame age, stress, or sleep for how they feel. It's usually the blood.' Description Style: Normal font weight, black/grey color, smaller font size, balanced line spacing.
    Button Text: 'Shop Now'
    Button Style: Primary button style with a bright lime-green background color and black text.
    Layout: Both columns should have even vertical spacing. Ensure there is distinct vertical gap (margin) between the heading, the paragraph, and  the button, matching the spacing shown in the image. Add subtle horizontal padding around the section.", make image size a little bit small also remove section margin top and bottom, decrease heading margin bottom a little bit, add a little bit margin top and bottom 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_vertical }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_width }}% 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    align-items: center;
  }

  .ai-two-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-two-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-two-column-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-two-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
  }

  .ai-two-column-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: {{ block.settings.description_weight }};
    color: {{ block.settings.description_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0 0 {{ block.settings.description_margin_bottom }}px 0;
  }

  .ai-two-column-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-two-column-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

@media screen and (max-width: 749px) {
  /* Container setup and order */
  .ai-two-column-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column-reverse; /* Text TOP par, Image BOTTOM par */
    gap: 10px !important; /* Image aur Text ke darmiyan gap kam kiya */
  }

  /* Heading ka size aur line spacing */
  .ai-two-column-heading-{{ ai_gen_id }} {
    font-size: 24px !important; /* Fixed size taake heading bohot jaga na le */
    line-height: 1.1 !important;
    margin-bottom: 8px !important;
    margin-top: 0px !important;
  }

  /* Description (paragraph) ke margins */
  .ai-two-column-description-{{ ai_gen_id }} {
    font-size: 14px !important;
    margin-bottom: 12px !important;
    line-height: 1.3 !important;
  }

  /* Content area ki internal padding (sides aur vertical) */
  .ai-two-column-content-{{ ai_gen_id }} {
    padding: 10px 15px !important; /* Padding kam kardi height bachane ke liye */
    text-align: center;
  }

  /* Main section ki overall height/padding */
  .ai-two-column-section-{{ ai_gen_id }} {
    padding-top: 15px !important;
    padding-bottom: 15px !important;
    padding-left: {{ block.settings.section_padding_horizontal }}px;
    padding-right: {{ block.settings.section_padding_horizontal }}px;
  }
}
{% endstyle %}
{% if page.handle == 'listicle-3' %}
<div class="ai-two-column-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-two-column-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-two-column-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-two-column-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-two-column-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </p>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-two-column-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
