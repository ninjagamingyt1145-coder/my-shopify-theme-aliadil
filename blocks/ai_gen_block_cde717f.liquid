      "default": "Premium Quality"
    },
    {
      "type": "textarea",
      "id": "feature_1_description",
      "label": "Description",
      "default": "Crafted with the finest ingredients for maximum effectiveness"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_heading",
      "label": "Heading",
      "default": "Clinically Tested"
    },
    {
      "type": "textarea",
      "id": "feature_2_description",
      "label": "Description",
      "default": "Backed by scientific research and clinical studies"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_heading",
      "label": "Heading",
      "default": "Fast Results"
    },
    {
      "type": "textarea",
      "id": "feature_3_description",
      "label": "Description",
      "default": "See noticeable improvements within the first few weeks"
    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature_4_heading",
      "label": "Heading",
      "default": "100% Natural"
    },
    {
      "type": "textarea",
      "id": "feature_4_description",
      "label": "Description",
      "default": "Made from pure, natural ingredients with no artificial additives"
    },
    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main heading",
      "default": "Transform Your Health Today"
    },
    {
      "type": "textarea",
      "id": "main_description",
      "label": "Description",
      "default": "Experience the power of nature with our premium blood sugar support formula. Designed to help you maintain healthy glucose levels naturally."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#2E2A39"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
