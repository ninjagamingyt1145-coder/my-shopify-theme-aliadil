{% doc %}
  @prompt
    "Create a custom Shopify Liquid section for a blog body with a two-column split layout where the image is on the right.
    Section Styling: Light blue-grey background
    (#F4F7F9) with 60px vertical padding.
    2. Layout: Split the section into two columns. On desktop, text is on the left and image is on the right. On mobile, stack them with the image on top.
    3. Left Column (Text & Button):
    • Heading: A bold H2 heading: '2. It Doesn't Fix The Problem (It Just Masks The Symptoms)'.
    • Paragraphs: > * 'Minoxidil widens blood
    vessels. More blood flow = temporary growth.'
    • 'But male pattern baldness isn't caused by poor blood flow. It's caused by DHT hormone strangling your follicles. Minoxidil does nothing about DHT!' • 'You're treating symptoms while the root cause keeps destroying your hair.'
    • Button: Below the text, add a large, rounded button with a solid blue background
    (#3B5998) and white text that says: 'BLOCK DHT AT THE SOURCE. Center the button relative to the text.
    4. Right Column (Image):
    • Add a placeholder for a detailed medical-style
    3D illustration. The image should be square/ rectangular with rounded corners (8px).
    5. Alignment: Vertically center the text and button column so it aligns with the middle of the image.
    6. Customizability: Make the heading, all paragraph text, the button link/text, and the image fully editable.", remove margin top, why space up of paragraph remove it, remove gap of paragraph , remove heading margin bottom, remove margin top of paragraphs, just show image remove image border radius container just square image , make image size small not that big just square size image, remove margin top of heading and image, remove little bit margin bottom, remove margin bottom, add a little bit margin bottom, make a button size little bit small, add a little bit margin bottom, add a little bit margin top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-split-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: 20px 20px 40px 20px;
    width: 100%;
  }

  .ai-blog-split-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-blog-split-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ai-blog-split-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }} {
  font-size: {{ block.settings.paragraph_size }}px;
  color: {{ block.settings.text_color }};
  line-height: 1.8;
  margin-bottom: 15px; /* Har paragraph ke baad 15px ka gap aayega */
}

  .ai-blog-split-paragraph-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-blog-split-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 24px;
  }

  .ai-blog-split-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-blog-split-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .ai-blog-split-image-column-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-split-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    max-width: 100%;
  }

  .ai-blog-split-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-blog-split-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-blog-split-image-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
  }

  .ai-blog-split-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-split-container-{{ ai_gen_id }} {
  grid-template-columns: 1fr;
  gap: 15px; /* Isay 30 se kam karke dekhein */
}

    .ai-blog-split-image-column-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-blog-split-image-wrapper-{{ ai_gen_id }} {
  width: 100% !important; /* Mobile ki poori width cover karne ke liye */
  height: auto; 
  margin-bottom: 0px;
}
   .ai-blog-split-heading-{{ ai_gen_id }} {
  font-size: {{ block.settings.heading_size | times: 0.8 }}px;
  margin-top: 0 !important; /* Image ke bilkul saath jorne ke liye */
  padding-top: 0 !important;
}

    .ai-blog-split-paragraph-{{ ai_gen_id }} {
  font-size: {{ block.settings.paragraph_size | times: 0.9 }}px;
  margin-bottom: 12px; /* Mobile par paragraphs ke beech gap ke liye */
  text-align: left;    /* Agar text center ho raha hai toh isse theek hoga */
}

    .ai-blog-split-button-{{ ai_gen_id }} {
      padding: 12px 28px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}
{% if request.page_type == 'page' and handle == 'listicle-2' %}
<blog-split-section-{{ ai_gen_id }}
  class="ai-blog-split-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-blog-split-container-{{ ai_gen_id }}">
    <div class="ai-blog-split-text-column-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h2 class="ai-blog-split-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if block.settings.paragraph_1 != blank -%}
        <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
          {{ block.settings.paragraph_1 }}
        </div>
      {%- endif -%}

      {%- if block.settings.paragraph_2 != blank -%}
        <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
          {{ block.settings.paragraph_2 }}
        </div>
      {%- endif -%}

      {%- if block.settings.paragraph_3 != blank -%}
        <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
          {{ block.settings.paragraph_3 }}
        </div>
      {%- endif -%}

      {% if block.settings.paragraph_4 != blank %}
  <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
    {{ block.settings.paragraph_4 }}
  </div>
{% endif %}

 {% if block.settings.paragraph_5 != blank %}
  <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
    {{ block.settings.paragraph_5 }}
  </div>
{% endif %}

{% if block.settings.paragraph_6 != blank %}
  <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
    {{ block.settings.paragraph_6 }}
  </div>
{% endif %}

{% if block.settings.paragraph_7 != blank %}
  <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
    {{ block.settings.paragraph_7 }}
  </div>
{% endif %}

      {%- if block.settings.button_text != blank -%}
        <div class="ai-blog-split-button-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="ai-blog-split-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="ai-blog-split-image-column-{{ ai_gen_id }}">
      <div class="ai-blog-split-image-wrapper-{{ ai_gen_id }}">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-blog-split-image-{{ ai_gen_id }}"
          >
        {%- else -%}
          <div class="ai-blog-split-image-placeholder-{{ ai_gen_id }}">
            {{ 'detailed-apparel-1' | placeholder_svg_tag }}
            <div class="ai-blog-split-empty-state-{{ ai_gen_id }}">
              Next, add an image
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</blog-split-section-{{ ai_gen_id }}>
{%- endif -%}
