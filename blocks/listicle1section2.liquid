{% doc %}
  @prompt
    "Create a custom Shopify Liquid section for a blog body with a two-column split layout.
    1. Section Styling: Set the background color to a very light blue-grey (#F4F7F9). Add 60px vertical padding.
    2. Layout: On desktop, the section should split into two equal columns. On mobile, the image should move to the top and the text below it.
    3. Left Column (Image):
    • Place an image placeholder. The image should be square with a thin 1px grey border.
    • Ensure the image has a fixed max-width (e.g., 450px) and is centered within its column.
    4. Right Column (Text):
    • Heading: A bold, large H2 heading: '1.
    Minoxidil Is A Lifetime Sentence (Not A
    Temporary Treatment)'.
    • Paragraphs: Add the following text with proper spacing (20px gap between paragraphs):  • 'Stop using it, and you lose everything.
    Most guys think they'll use it for 6-12 months then quit. Wrong.'
    • 'The moment you stop (whether 6 months or 16 years later) all progress reverses. Often worse than before. You're signing up for twice-daily applications forever!'
    • 'Forget to apply before a trip? Panic. Skip a morning? Guilt all day. You're literally chained to a bottle for life.'
    5. Alignment: All text in the right column must be left-aligned. Vertical alignment of the text should be centered relative to the image on the
    left.
    6. Customizability: Make the image, the heading and every paragraph fully editable in the Shopify theme editor.", , remove margin top , remove heading margin bottom, remove margin top and bottom, remove paragraph margin top, why too much space on paragraph top remove it, reduce the heading up side gap, remove paragraph margin top, decrease heading margin bottom, remove heading margin bottom, decrease image margin bottom on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-split-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    width: 100%;
    margin: 0;
  }

  .ai-blog-split-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-split-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-blog-split-image-column-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-blog-split-image-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.image_max_width }}px;
    width: 100%;
  }

  .ai-blog-split-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid {{ block.settings.image_border_color }};
    display: block;
  }

  .ai-blog-split-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid {{ block.settings.image_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9;
  }

  .ai-blog-split-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-blog-split-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    gap: 0;
  }

  .ai-blog-split-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-blog-split-paragraph-{{ ai_gen_id }}:not(:last-child) {
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-blog-split-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .ai-blog-split-image-column-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-blog-split-text-column-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-blog-split-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-blog-split-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}
{% if request.page_type == 'page' and handle == 'listicle-1' %}
<blog-split-section-{{ ai_gen_id }} class="ai-blog-split-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-split-container-{{ ai_gen_id }}">
    <div class="ai-blog-split-layout-{{ ai_gen_id }}">
      <div class="ai-blog-split-image-column-{{ ai_gen_id }}">
        <div class="ai-blog-split-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | escape }}"
              class="ai-blog-split-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="ai-blog-split-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-blog-split-text-column-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-split-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.paragraph_1 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
            {{ block.settings.paragraph_1 }}
          </div>
        {% endif %}

        {% if block.settings.paragraph_2 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
            {{ block.settings.paragraph_2 }}
          </div>
        {% endif %}

        {% if block.settings.paragraph_3 != blank %}
          <div class="ai-blog-split-paragraph-{{ ai_gen_id }}">
            {{ block.settings.paragraph_3 }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</blog-split-section-{{ ai_gen_id }}>
 {% endif %}
{% schema %}
{
  "name": "Blog split layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>1. Minoxidil Is A Lifetime Sentence (Not A Temporary Treatment)</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>Stop using it, and you lose everything. Most guys think they'll use it for 6-12 months then quit. Wrong.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>The moment you stop (whether 6 months or 16 years later) all progress reverses. Often worse than before. You're signing up for twice-daily applications forever!</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "<p>Forget to apply before a trip? Panic. Skip a morning? Guilt all day. You're literally chained to a bottle for life.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F7F9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Blog split layout"
    }
  ]
}
{% endschema %}
