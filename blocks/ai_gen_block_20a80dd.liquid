      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "range",
      "id": "divider_size",
      "label": "Divider size",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 5
