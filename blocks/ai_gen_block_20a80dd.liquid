      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "label": "Scroll duration",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker"
    }
  ]
}
{% endschema %}
