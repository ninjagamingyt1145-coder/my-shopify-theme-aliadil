{% doc %}
  @prompt
    "Create a high-converting, responsive Shopify Liquid section titled 'Product Detail Hero'.
    
    Layout & Design:
    
    Desktop: A 2-column layout. The left column displays a product image (aligned left). The right column contains the content (aligned left).
    
    Mobile: A stacked layout where the product image appears above the content, and all text elements are center-aligned.
    
    Background: The section should have a full-width background color setting.
    
    Content Requirements (Right Column):
    
    Rating Star: A row containing 5 gold star icons, followed by text 'Rated 4.6 Excellent'.
    
    Heading: A large, bold H1 heading (e.g., 'Daily Wellness Support').
    
    Sub-heading: A text field with a small heart icon before the text (e.g., '❤ Odorless Aged Garlic Extract').
    
    Description: A text area for a product summary.
    
    CTA Button: A wide, full-width (or large) prominent button with a custom background color and rounded corners (text: 'SHOP NOW').
    
    Trust Badge: A small line below the button with a location/checkmark icon and text (e.g., '30-day money-back guarantee')., make this section little bit small on mobile and heading should show in one line on mobile , show heading in one line on desktop, remove rating margin bottom also reduce heading margin bottom little bit and reduce little bit subheading margin bottom also and add entry animation, add a little bit margin bottom on rating
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-product-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-hero-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-product-hero-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-image-wrapper-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateX(0);
  }

  .ai-product-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-product-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-product-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-hero-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-product-hero-content-{{ ai_gen_id }} > * {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(1) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.2s;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(2) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.3s;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(3) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.4s;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(4) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(5) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.6s;
  }

  .ai-product-hero-{{ ai_gen_id }}.animated .ai-product-hero-content-{{ ai_gen_id }} > *:nth-child(6) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.7s;
  }

  .ai-product-hero-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-product-hero-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-product-hero-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-product-hero-rating-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.rating_text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-product-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px 0;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ai-product-hero-subheading-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin-bottom: 8px;
  }

  .ai-product-hero-heart-{{ ai_gen_id }} {
    width: {{ block.settings.heart_size }}px;
    height: {{ block.settings.heart_size }}px;
    fill: {{ block.settings.heart_color }};
    flex-shrink: 0;
  }

  .ai-product-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-product-hero-cta-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-align: center;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-product-hero-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-product-hero-trust-badge-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.trust_badge_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-hero-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.trust_icon_size }}px;
    height: {{ block.settings.trust_icon_size }}px;
    fill: {{ block.settings.trust_icon_color }};
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px 0 {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-product-hero-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-product-hero-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-hero-content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-product-hero-rating-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-product-hero-subheading-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-product-hero-trust-badge-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-product-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-product-hero-star-{{ ai_gen_id }} {
      width: {{ block.settings.star_size | times: 0.8 }}px;
      height: {{ block.settings.star_size | times: 0.8 }}px;
    }

    .ai-product-hero-rating-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.rating_text_size | times: 0.9 }}px;
    }

    .ai-product-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-product-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-product-hero-cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }

    .ai-product-hero-trust-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.trust_badge_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<product-hero-{{ ai_gen_id }} class="ai-product-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-hero-container-{{ ai_gen_id }}">
    <div class="ai-product-hero-grid-{{ ai_gen_id }}">
      <div class="ai-product-hero-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1200 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            class="ai-product-hero-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-product-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-product-hero-empty-state-{{ ai_gen_id }}">
              Add a product image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-product-hero-content-{{ ai_gen_id }}">
        {% if block.settings.show_rating %}
          <div class="ai-product-hero-rating-{{ ai_gen_id }}">
            <div class="ai-product-hero-stars-{{ ai_gen_id }}">
              {% for i in (1..5) %}
                <svg class="ai-product-hero-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
            <span class="ai-product-hero-rating-text-{{ ai_gen_id }}">{{ block.settings.rating_text }}</span>
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h1 class="ai-product-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-product-hero-subheading-{{ ai_gen_id }}">
            <svg class="ai-product-hero-heart-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>{{ block.settings.subheading }}</span>
          </div>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-product-hero-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-product-hero-cta-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}

        {% if block.settings.trust_badge_text != blank %}
          <div class="ai-product-hero-trust-badge-{{ ai_gen_id }}">
            <svg class="ai-product-hero-trust-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
            <span>{{ block.settings.trust_badge_text }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</product-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initAnimation();
      }

      initAnimation() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.classList.add('animated');
              observer.unobserve(this);
            }
          });
        }, {
          threshold: 0.1
        });

        observer.observe(this);
      }
    }

    customElements.define('product-hero-{{ ai_gen_id }}', ProductHero{{ ai_gen_id }});
  })();
</script>

